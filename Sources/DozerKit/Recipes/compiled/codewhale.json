{
  "args" : {
    "version" : {
      "buildArg" : "CODEWHALE_VERSION",
      "default" : "0.10.1",
      "description" : "The CodeWhale release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Hunter Bown and contributors",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.anthropic.com",
                "reason" : "Anthropic — when the sandbox's key is Anthropic's"
              },
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/chat/completions"
                ],
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              }
            ],
            "id" : "model:codewhale",
            "phrase" : "talk to your AI model",
            "summary" : "CodeWhale's model — the provider or gateway its key is for (Anthropic, OpenAI, xAI, Google AI or OpenRouter), with an API key. Needed for CodeWhale to answer.",
            "title" : "Talk to its model provider"
          },
          "quiet" : [
            {
              "host" : "models.dev",
              "reason" : "CodeWhale's TUI refreshes the public models.dev catalogue when it starts; it has the catalogue bundled and does without the refresh when refused"
            }
          ],
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.anthropic.com:443",
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443"
          ],
          "deny" : [
            "models.dev:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.codewhale"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "codewhale",
        "integrity" : "sha512-F/gS+8C4eANXPF15cRvzss7lowLk96a1tlOPZWxdNHveKURQdU9cRQ+RlW4Di0lg4TgXsfRCebR/AS1i0qhpzw==",
        "kind" : "release-binary",
        "url" : "https://github.com/Hmbown/CodeWhale/releases/download/v${{ kit.args.version }}/codewhale-linux-arm64"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "codewhale",
            "exec",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "codewhale",
          "--skip-onboarding"
        ],
        "env" : {
          "CODEWHALE_NO_UPDATE_CHECK" : "1",
          "CODEWHALE_TELEMETRY" : "0"
        },
        "no_prompts_args" : [
          "--approval-policy",
          "never"
        ],
        "passthrough" : [
          "--version",
          "-V",
          "--help",
          "-h",
          "help",
          "exec",
          "auth",
          "models",
          "doctor",
          "update",
          "config"
        ],
        "resume" : [
          "--continue"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "codewhale",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "CodeWhale's built-in providers (CODEWHALE_PROVIDER, CODEWHALE_MODEL), each reading its own key from the environment; on xAI (the default) the model is grok-build-0.1. Its own account (hosted keys) is not used.",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "api-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.anthropic.com/settings/keys",
            "kind" : "api-key",
            "note" : "CodeWhale through Anthropic: doz try codewhale --provider anthropic (or choose it in the try setup); the model with --model.",
            "provider" : "anthropic"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "CodeWhale through OpenAI: doz try codewhale --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "CodeWhale through Google AI: doz try codewhale --provider google (or choose it in the try setup); the model with --model.",
            "provider" : "google"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "CodeWhale through OpenRouter: doz try codewhale --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "level" : "verified"
          },
          {
            "checked" : "2026-10-16",
            "gateway" : "vercel-ai-gateway",
            "level" : "no",
            "reason" : "CodeWhale has no Vercel AI Gateway provider, and it sends a key from the environment only to a built-in provider's own endpoint (a custom base URL needs its own stored credential)",
            "source" : "https://github.com/Hmbown/CodeWhale/blob/v0.10.1/docs/PROVIDERS.md"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "models" : {
          "xai" : "grok-build-0.1"
        },
        "native" : [
          {
            "env" : {
              "CODEWHALE_MODEL" : "${{ dozer.model }}",
              "CODEWHALE_PROVIDER" : "xai"
            },
            "source" : "xai"
          },
          {
            "env" : {
              "CODEWHALE_MODEL" : "${{ dozer.model }}",
              "CODEWHALE_PROVIDER" : "openai"
            },
            "source" : "openai"
          },
          {
            "env" : {
              "CODEWHALE_MODEL" : "${{ dozer.model }}",
              "CODEWHALE_PROVIDER" : "anthropic"
            },
            "source" : "anthropic"
          },
          {
            "docs" : "https://github.com/Hmbown/CodeWhale/blob/v0.10.1/docs/PROVIDERS.md",
            "env" : {
              "CODEWHALE_MODEL" : "${{ dozer.model }}",
              "CODEWHALE_PROVIDER" : "openrouter"
            },
            "source" : "openrouter"
          },
          {
            "env" : {
              "CODEWHALE_MODEL" : "${{ dozer.model }}",
              "CODEWHALE_PROVIDER" : "google"
            },
            "source" : "google"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "deepseek-tui"
        ],
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "debian",
        "icon" : "codewhale",
        "kind" : "coding-agent",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: codewhale exec \"say ok\" printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "codewhale exec \"…\" (--auto for tools)"
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default)."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/Hmbown/CodeWhale",
        "intro" : "CodeWhale is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "codewhale exec \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "codewhale exec \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "A provider-neutral coding agent for the terminal (formerly DeepSeek TUI), on the key of the provider or gateway you choose (xAI by default).",
  "displayName" : "CodeWhale",
  "id" : "hmbown/codewhale",
  "kind" : "workload",
  "licenses" : [
    "MIT"
  ],
  "provides" : [
    "com.dozersandbox/codewhale@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/Hmbown/CodeWhale"
}
