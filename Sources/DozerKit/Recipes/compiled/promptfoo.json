{
  "args" : {
    "version" : {
      "buildArg" : "PROMPTFOO_VERSION",
      "default" : "0.124.1",
      "description" : "The promptfoo release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+(\\.[0-9]+)?([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "promptfoo",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:promptfoo",
            "phrase" : "talk to your AI model",
            "summary" : "promptfoo's model — the provider or gateway its key is for (OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for promptfoo to answer.",
            "title" : "Talk to its model provider"
          },
          "quiet" : [
            {
              "host" : "r.promptfoo.app",
              "reason" : "promptfoo reports that its telemetry is off (one \"telemetry disabled\" event each run) even with PROMPTFOO_DISABLE_TELEMETRY; no setting stops it"
            }
          ],
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443"
          ],
          "deny" : [
            "r.promptfoo.app:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.promptfoo"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "binary" : "promptfoo",
        "integrity" : "sha512-Y6fq/WGTL7lPvDsirNSmmmcPLhURwRao03iv8fCoLbFq6H1eqg5VVTmXiap5Jl+fiRaQQZXYMHb2N1gQm1tGyQ==",
        "kind" : "npm",
        "needs_node" : "22",
        "package" : "promptfoo"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "sh",
            "-c",
            "echo \"say ok\" > /tmp/prompt.txt && promptfoo eval -p /tmp/prompt.txt -r \"openai:chat:$DOZ_MODEL\" --no-cache"
          ],
          "expect" : "DOZ_FAKE_OK",
          "timeout" : 300
        },
        "command" : [
          "promptfoo"
        ],
        "env" : {
          "PROMPTFOO_DISABLE_TELEMETRY" : "1",
          "PROMPTFOO_DISABLE_UPDATE" : "1"
        },
        "no_prompts_args" : [

        ],
        "passthrough" : [
          "--version",
          "-V",
          "--help",
          "-h"
        ],
        "session" : "shell",
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "promptfoo",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "promptfoo's openai provider is pointed at the chosen source (OPENAI_BASE_URL, the key under OPENAI_API_KEY; providers: [openai:chat:$DOZ_MODEL] in a config); its xai provider reads XAI_API_KEY too. Its telemetry and update check are off.",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "promptfoo through OpenAI: doz try promptfoo --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "promptfoo through Google AI: doz try promptfoo --provider google (or choose it in the try setup); the model with --model.",
            "provider" : "google"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "promptfoo through OpenRouter: doz try promptfoo --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://vercel.com/docs/ai-gateway/authentication-and-byok",
            "kind" : "api-key",
            "note" : "promptfoo through Vercel AI Gateway: doz try promptfoo --gateway vercel-ai-gateway (or choose it in the try setup); the model with --model.",
            "provider" : "vercel-ai-gateway"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "endpoint" : "v1",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "how" : {
              "env" : {
                "DOZ_MODEL" : "${{ dozer.model }}",
                "OPENAI_BASE_URL" : "${{ dozer.gateway.endpoint.v1 }}"
              }
            },
            "level" : "verified",
            "shape" : "openai-chat"
          },
          {
            "checked" : "2026-10-14",
            "endpoint" : "v1",
            "evidence" : "make recipe-check: its check turn through a stand-in Vercel AI Gateway (doz try with --gateway vercel-ai-gateway; models@1)",
            "gateway" : "vercel-ai-gateway",
            "how" : {
              "env" : {
                "DOZ_MODEL" : "${{ dozer.model }}",
                "OPENAI_BASE_URL" : "${{ dozer.gateway.endpoint.v1 }}"
              }
            },
            "level" : "verified",
            "shape" : "openai-chat"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "shapes" : [
          {
            "env" : {
              "DOZ_MODEL" : "${{ dozer.model }}",
              "OPENAI_BASE_URL" : "${{ dozer.base_url }}"
            },
            "key_env" : [
              "OPENAI_API_KEY"
            ],
            "shape" : "openai-chat"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "categories" : [
          "evaluation"
        ],
        "default_base" : "debian",
        "icon" : "promptfoo",
        "kind" : "ai-tool",
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "A2 VM proof: its check turn answered DOZ_FAKE_OK through the fake provider (make recipe-check; probes/617-*/recipes/promptfoo)",
            "level" : "verified",
            "notes" : [
              "promptfoo eval -c CONFIG"
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default). promptfoo view (its web viewer) needs a forwarded port, which Dozer does not offer yet."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://www.promptfoo.dev/docs/intro/",
        "intro" : "promptfoo evaluates and red-teams prompts and LLM apps from a config of prompts, providers and tests. It runs in your shell and exits.",
        "steps" : [
          {
            "command" : "echo \"say ok\" > /tmp/prompt.txt && promptfoo eval -p /tmp/prompt.txt -r \"openai:chat:$DOZ_MODEL\" --no-cache",
            "text" : "Check it answers: one prompt against your model."
          },
          {
            "command" : "promptfoo --help",
            "text" : "See its commands."
          }
        ],
        "tips" : [
          "`promptfoo init` writes an example `promptfooconfig.yaml` in your folder.",
          "`DOZ_MODEL` is the model for the key you chose: `openai:chat:$DOZ_MODEL`.",
          "Its telemetry and update check are off."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "A command line for evaluating and red-teaming LLM prompts and apps, on an xAI, OpenAI, Google AI, OpenRouter or Vercel AI Gateway key.",
  "displayName" : "promptfoo",
  "id" : "promptfoo/promptfoo",
  "kind" : "workload",
  "licenses" : [
    "MIT"
  ],
  "provides" : [
    "com.dozersandbox/promptfoo@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/promptfoo/promptfoo"
}
