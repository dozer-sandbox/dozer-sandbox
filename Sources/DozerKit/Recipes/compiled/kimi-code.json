{
  "args" : {
    "version" : {
      "buildArg" : "KIMI_CODE_VERSION",
      "default" : "2.1.1",
      "description" : "The Kimi Code release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Moonshot AI",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.anthropic.com",
                "reason" : "Anthropic — when the sandbox's key is Anthropic's"
              },
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/chat/completions"
                ],
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:kimi-code",
            "phrase" : "talk to your AI model",
            "summary" : "Kimi Code's model — the provider or gateway its key is for (Anthropic, OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for Kimi Code to answer.",
            "title" : "Talk to its model provider"
          },
          "quiet" : [
            {
              "host" : "api.kimi.com",
              "reason" : "Kimi Code fetches Moonshot's public client settings (POST /coding/v1/client_configs, no credential) at each start and does without them when refused; no setting of its own stops it"
            }
          ],
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.anthropic.com:443",
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443"
          ],
          "deny" : [
            "api.kimi.com:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.kimi-code"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "binary" : "kimi",
        "integrity" : "sha512-xClqcnTQUKgKDbeOGPU78qcwxGzL8wA2rqWuOX3CLpyQ1/NhSX7jAh6hZo/JFwThSX8obkgef3uw/li5JaJNyw==",
        "kind" : "npm",
        "needs_node" : "22",
        "npm_args" : [
          "--ignore-scripts"
        ],
        "package" : "@moonshot-ai/kimi-code"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "kimi",
            "-p",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK",
          "screen" : {
            "allow" : [
              "Welcome to Kimi Code"
            ],
            "expect" : [
              "context"
            ]
          }
        },
        "command" : [
          "kimi"
        ],
        "env" : {
          "KIMI_CODE_NO_AUTO_UPDATE" : "1",
          "KIMI_DISABLE_TELEMETRY" : "1"
        },
        "first_run" : [
          {
            "file" : "~/.kimi-code/config.toml",
            "set" : {
              "default_model" : "grok-build",
              "models.grok-build.max_context_size" : 256000,
              "models.grok-build.model" : "grok-build-0.1",
              "models.grok-build.provider" : "xai",
              "providers.xai.api_key_env" : "XAI_API_KEY",
              "providers.xai.base_url" : "https://api.x.ai/v1",
              "providers.xai.type" : "openai",
              "telemetry" : false
            }
          },
          {
            "file" : "~/.kimi-code/workspace-trust/wd_workspace_c52ddf65534b",
            "format" : "json",
            "set" : {
              "root" : "/workspace",
              "trustedAt" : 1791936000000
            }
          }
        ],
        "no_prompts_args" : [
          "--auto"
        ],
        "passthrough" : [
          "--version",
          "-V",
          "--help",
          "-h",
          "help",
          "provider",
          "session",
          "doctor",
          "export",
          "upgrade",
          "update",
          "-p",
          "--prompt"
        ],
        "resume" : [
          "--continue"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "kimi",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Kimi Code's model from the environment (KIMI_MODEL_NAME, KIMI_MODEL_PROVIDER_TYPE, KIMI_MODEL_BASE_URL; the key's placeholder under KIMI_MODEL_API_KEY), pointed at the chosen provider or gateway. On xAI (the default) the model is grok-build-0.1. Moonshot's own sign-in and keys Dozer does not offer yet.",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "api-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.anthropic.com/settings/keys",
            "kind" : "api-key",
            "note" : "Kimi Code through Anthropic: doz try kimi-code --provider anthropic (or choose it in the try setup); the model with --model.",
            "provider" : "anthropic"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "Kimi Code through OpenAI: doz try kimi-code --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "Kimi Code through Google AI: doz try kimi-code --provider google (or choose it in the try setup); the model with --model.",
            "provider" : "google"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "Kimi Code through OpenRouter: doz try kimi-code --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://vercel.com/docs/ai-gateway/authentication-and-byok",
            "kind" : "api-key",
            "note" : "Kimi Code through Vercel AI Gateway: doz try kimi-code --gateway vercel-ai-gateway (or choose it in the try setup); the model with --model.",
            "provider" : "vercel-ai-gateway"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "level" : "verified"
          },
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in Vercel AI Gateway (doz try with --gateway vercel-ai-gateway; models@1)",
            "gateway" : "vercel-ai-gateway",
            "level" : "verified"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "models" : {
          "xai" : "grok-build-0.1"
        },
        "shapes" : [
          {
            "env" : {
              "KIMI_MODEL_BASE_URL" : "${{ dozer.base_url }}",
              "KIMI_MODEL_MAX_CONTEXT_SIZE" : "256000",
              "KIMI_MODEL_NAME" : "${{ dozer.model }}",
              "KIMI_MODEL_PROVIDER_TYPE" : "openai"
            },
            "key_env" : [
              "KIMI_MODEL_API_KEY"
            ],
            "shape" : "openai-chat",
            "source" : "https://moonshotai.github.io/kimi-code/en/configuration/env-vars"
          },
          {
            "env" : {
              "KIMI_MODEL_BASE_URL" : "${{ dozer.base_url }}",
              "KIMI_MODEL_MAX_CONTEXT_SIZE" : "200000",
              "KIMI_MODEL_NAME" : "${{ dozer.model }}",
              "KIMI_MODEL_PROVIDER_TYPE" : "anthropic"
            },
            "key_env" : [
              "KIMI_MODEL_API_KEY"
            ],
            "shape" : "anthropic-messages",
            "source" : "https://moonshotai.github.io/kimi-code/en/configuration/env-vars"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "kimi"
        ],
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "node",
        "icon" : "kimi-code",
        "kind" : "coding-agent",
        "limits" : [
          {
            "musl" : true,
            "reason" : "Kimi Code needs Node 22.19 or later; Alpine's Node is older"
          }
        ],
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: kimi -p \"say ok\" printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "kimi -p \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default)."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/MoonshotAI/kimi-code",
        "intro" : "Kimi Code is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "kimi -p \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "kimi -p \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "Moonshot AI's coding agent for the terminal (the successor to kimi-cli), on the key of the provider or gateway you choose (xAI by default).",
  "displayName" : "Kimi Code",
  "id" : "moonshotai/kimi-code",
  "kind" : "workload",
  "licenses" : [
    "MIT"
  ],
  "provides" : [
    "com.dozersandbox/kimi-code@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/MoonshotAI/kimi-code"
}
