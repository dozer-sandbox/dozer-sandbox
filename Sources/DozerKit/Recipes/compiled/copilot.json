{
  "args" : {
    "version" : {
      "buildArg" : "COPILOT_VERSION",
      "default" : "1.0.97",
      "description" : "The GitHub Copilot CLI release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "GitHub",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/models",
                  "/v1/chat/completions",
                  "/v1/responses"
                ]
              }
            ],
            "id" : "model:copilot",
            "phrase" : "talk to your AI model (xAI)",
            "summary" : "GitHub Copilot CLI's model here (the xAI API, with your key) — needed for it to answer.",
            "title" : "Talk to xAI"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.x.ai:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ],
          "env_aliases" : [
            "COPILOT_PROVIDER_API_KEY"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.copilot"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "directory" : "/home/agent/.copilot/skills/dozer",
        "dozer" : {
          "kind" : "skill"
        },
        "filename" : "SKILL.md"
      },
      "type" : "com.docker.sandbox/agent-context@1"
    },
    {
      "config" : {
        "binary" : "copilot",
        "integrity" : "sha512-iWtoEeG4kN1tz5f1tsHQKdwCQ24Dpx8+rGZ1GBn42U57QU5yjIhIeYR8DXJGFWTtoHwQn0uAlacbhDlqKYddYQ==",
        "kind" : "npm-platform-binary",
        "package" : "@github/copilot",
        "payload" : "copilot",
        "platform_package" : "@github/copilot-linux-arm64"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "copilot",
            "-p",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "copilot"
        ],
        "env" : {
          "COPILOT_AUTO_UPDATE" : "false",
          "COPILOT_MODEL" : "grok-code-fast-1",
          "COPILOT_OFFLINE" : "true",
          "COPILOT_PROVIDER_BASE_URL" : "https://api.x.ai/v1",
          "COPILOT_PROVIDER_TYPE" : "openai"
        },
        "first_run" : [
          {
            "file" : "~/.copilot/config.json",
            "set" : {
              "trustedFolders" : [
                "/workspace"
              ]
            }
          }
        ],
        "no_prompts_args" : [
          "--allow-all"
        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h",
          "help",
          "version",
          "login",
          "init",
          "config",
          "update",
          "sessions",
          "memories",
          "plugin",
          "mcp",
          "skill",
          "instruction",
          "lsp",
          "sandbox",
          "completion",
          "app",
          "workflow"
        ],
        "resume" : [
          "--continue"
        ],
        "state_env" : {
          "COPILOT_HOME" : "/home/agent/.copilot"
        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "copilot",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "GitHub Copilot CLI's own BYOK mode (COPILOT_PROVIDER_*), offline from GitHub — no Copilot plan or GitHub sign-in. Dozer offers it on an xAI key for now.",
            "provider" : "xai"
          },
          {
            "account" : "a GitHub account with a Copilot plan",
            "checked" : "2026-10-14",
            "in_sandbox" : false,
            "kind" : "vendor-sign-in",
            "note" : "Copilot's own sign-in (copilot login, or a fine-grained token with Copilot Requests) would live in the sandbox's state; Dozer does not offer it yet."
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "endpoint" : "v1",
            "gateway" : "openrouter",
            "how" : {
              "env" : {
                "COPILOT_MODEL" : "${{ dozer.model }}",
                "COPILOT_PROVIDER_API_KEY" : "${{ dozer.placeholder }}",
                "COPILOT_PROVIDER_BASE_URL" : "${{ dozer.gateway.endpoint.v1 }}",
                "COPILOT_PROVIDER_TYPE" : "openai"
              }
            },
            "level" : "documented",
            "limits" : [
              "the model must support tool calls and streaming"
            ],
            "shape" : "openai-chat",
            "source" : "https://docs.github.com/en/copilot/how-tos/copilot-cli/customize-copilot/use-byok-models"
          },
          {
            "checked" : "2026-10-14",
            "endpoint" : "v1",
            "gateway" : "vercel-ai-gateway",
            "how" : {
              "env" : {
                "COPILOT_MODEL" : "${{ dozer.model }}",
                "COPILOT_PROVIDER_API_KEY" : "${{ dozer.placeholder }}",
                "COPILOT_PROVIDER_BASE_URL" : "${{ dozer.gateway.endpoint.v1 }}",
                "COPILOT_PROVIDER_TYPE" : "openai"
              }
            },
            "level" : "documented",
            "limits" : [
              "the model must support tool calls and streaming"
            ],
            "shape" : "openai-chat",
            "source" : "https://docs.github.com/en/copilot/how-tos/copilot-cli/customize-copilot/use-byok-models"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "copilot-cli"
        ],
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "debian",
        "icon" : "copilot",
        "kind" : "coding-agent",
        "licence" : "Proprietary (GitHub Copilot CLI License)",
        "limits" : [
          {
            "musl" : true,
            "reason" : "Dozer installs Copilot CLI's glibc build; its musl build is a separate package, not used yet"
          }
        ],
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "level" : "documented",
            "notes" : [
              "copilot -p \"…\""
            ],
            "source" : "https://docs.github.com/en/copilot/how-tos/copilot-cli/automate-copilot-cli/run-cli-programmatically",
            "tag" : "headless"
          }
        ],
        "terms" : "Your xAI API key — a key from console.x.ai. GitHub Copilot CLI is GitHub's software under its own licence; Dozer installs it from the npm registry."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/github/copilot-cli",
        "intro" : "GitHub Copilot CLI is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "copilot -p \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "copilot -p \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "GitHub's coding agent for the terminal, here with your own model key (xAI) instead of a Copilot plan.",
  "displayName" : "GitHub Copilot CLI",
  "id" : "github/copilot",
  "kind" : "workload",
  "licenses" : [
    "LicenseRef-GitHub-Copilot-CLI"
  ],
  "provides" : [
    "com.dozersandbox/copilot@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/github/copilot-cli"
}
