{
  "args" : {
    "version" : {
      "buildArg" : "LETTA_CODE_VERSION",
      "default" : "0.34.13",
      "description" : "The Letta Code release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Letta",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.anthropic.com",
                "reason" : "Anthropic — when the sandbox's key is Anthropic's"
              },
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/responses"
                ],
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:letta-code",
            "phrase" : "talk to your AI model",
            "summary" : "Letta Code's model — the provider or gateway its key is for (Anthropic, OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for Letta Code to answer.",
            "title" : "Talk to its model provider"
          },
          "quiet" : [
            {
              "host" : "api.letta.com",
              "reason" : "Letta Code asks Letta Cloud for its health and the account's balance when its TUI starts, even on the local backend with no account; it does without them when refused"
            }
          ],
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.anthropic.com:443",
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443"
          ],
          "deny" : [
            "api.letta.com:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.letta"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "binary" : "letta",
        "integrity" : "sha512-aEu3M1aYGA2HzpDjRd4rMJKRe4owLpPvdUnQZ0Nzf9/I7wo5Bl0yu7oM8hxBvelCZpPVug+pI/K06fBhbq4ckw==",
        "kind" : "npm",
        "needs_node" : "22",
        "npm_args" : [
          "--ignore-scripts"
        ],
        "package" : "@letta-ai/letta-code"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "letta",
            "--backend",
            "local",
            "--new-agent",
            "-p",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK",
          "screen" : {
            "allow" : [
              "/login +sign in with Letta"
            ]
          }
        },
        "command" : [
          "letta",
          "--backend",
          "local"
        ],
        "env" : {
          "DISABLE_AUTOUPDATER" : "1",
          "LETTA_CODE_TELEM" : "0"
        },
        "model_args" : [
          "-m",
          "$DOZ_MODEL"
        ],
        "no_prompts_args" : [

        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h",
          "memory",
          "agents",
          "model",
          "messages",
          "mcp",
          "mods",
          "skills",
          "backend",
          "connect",
          "setup",
          "update",
          "upgrade"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "letta",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Letta Code's local backend (--backend local, no Letta account) with its own providers, each reading its key from the environment; Dozer puts the model on its command line (-m xai/grok-4.3 on xAI, the default — grok-build-0.1 is not in its catalogue).",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "api-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.anthropic.com/settings/keys",
            "kind" : "api-key",
            "note" : "Letta Code through Anthropic: doz try letta-code --provider anthropic (or choose it in the try setup); the model with --model.",
            "provider" : "anthropic"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "Letta Code through OpenAI: doz try letta-code --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "Letta Code through Google AI: doz try letta-code --provider google (or choose it in the try setup); the model with --model.",
            "provider" : "google"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "Letta Code through OpenRouter: doz try letta-code --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://vercel.com/docs/ai-gateway/authentication-and-byok",
            "kind" : "api-key",
            "note" : "Letta Code through Vercel AI Gateway: doz try letta-code --gateway vercel-ai-gateway (or choose it in the try setup); the model with --model.",
            "provider" : "vercel-ai-gateway"
          },
          {
            "account" : "a Letta Cloud account",
            "checked" : "2026-10-14",
            "in_sandbox" : false,
            "kind" : "vendor-sign-in",
            "note" : "Letta Cloud's agents and memory sync need its sign-in; Dozer does not offer it yet."
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "level" : "verified"
          },
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in Vercel AI Gateway (doz try with --gateway vercel-ai-gateway; models@1)",
            "gateway" : "vercel-ai-gateway",
            "level" : "verified"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "models" : {
          "xai" : "grok-4.3"
        },
        "native" : [
          {
            "env" : {
              "DOZ_MODEL" : "anthropic/${{ dozer.model }}"
            },
            "source" : "anthropic"
          },
          {
            "env" : {
              "DOZ_MODEL" : "openai/${{ dozer.model }}"
            },
            "source" : "openai"
          },
          {
            "env" : {
              "DOZ_MODEL" : "xai/${{ dozer.model }}"
            },
            "source" : "xai"
          },
          {
            "env" : {
              "DOZ_MODEL" : "google/${{ dozer.model }}"
            },
            "source" : "google"
          },
          {
            "docs" : "https://github.com/letta-ai/letta-code#local-backend",
            "env" : {
              "DOZ_MODEL" : "openrouter/${{ dozer.model }}"
            },
            "source" : "openrouter"
          },
          {
            "docs" : "https://github.com/letta-ai/letta-code#local-backend",
            "env" : {
              "DOZ_MODEL" : "vercel-ai-gateway/${{ dozer.model }}"
            },
            "source" : "vercel-ai-gateway"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "letta"
        ],
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "node",
        "icon" : "letta-code",
        "kind" : "coding-agent",
        "limits" : [
          {
            "musl" : true,
            "reason" : "Letta Code needs Node 22.19 or later; Alpine's Node is older"
          }
        ],
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: letta -p \"say ok\" (local backend) printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "letta --backend local --new-agent -p \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default). Letta Cloud is not used."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/letta-ai/letta-code",
        "intro" : "Letta Code is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "letta --backend local --new-agent -p \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "letta --backend local --new-agent -p \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "Letta's memory-first coding agent, with its local backend (no Letta account), on the key of the provider or gateway you choose (xAI by default).",
  "displayName" : "Letta Code",
  "id" : "letta-ai/letta-code",
  "kind" : "workload",
  "licenses" : [
    "Apache-2.0"
  ],
  "provides" : [
    "com.dozersandbox/letta-code@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/letta-ai/letta-code"
}
