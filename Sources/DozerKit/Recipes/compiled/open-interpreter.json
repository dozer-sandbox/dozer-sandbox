{
  "args" : {
    "version" : {
      "buildArg" : "OPEN_INTERPRETER_VERSION",
      "default" : "0.0.56",
      "description" : "The Open Interpreter release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Open Interpreter",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/chat/completions"
                ],
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:open-interpreter",
            "phrase" : "talk to your AI model",
            "summary" : "Open Interpreter's model — the provider or gateway its key is for (OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for Open Interpreter to answer.",
            "title" : "Talk to its model provider"
          },
          "update" : [

          ],
          "vendor" : [
            {
              "host" : "raw.githubusercontent.com",
              "paths" : [
                "/openai/codex/main/announcement_tip.toml"
              ],
              "reason" : "its TUI reads Codex's announcement tips file when it starts (read-only; no setting turns it off)"
            }
          ]
        },
        "runtime" : {
          "allow" : [
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443",
            "raw.githubusercontent.com:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.openinterpreter"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "interpreter",
        "integrity" : "sha512-+wUeWOq+twYjtpVk+J5dfAgCXveoIlTyn3zkGCgsAwCkxzPKCq3ZzZWxq//uHBzQfGflqbpi0UEl3EDVPBG6FA==",
        "kind" : "release-binary",
        "payload" : "codex-aarch64-unknown-linux-musl",
        "url" : "https://github.com/openinterpreter/openinterpreter/releases/download/rust-v${{ kit.args.version }}/codex-aarch64-unknown-linux-musl.tar.gz"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "interpreter",
            "exec",
            "--skip-git-repo-check",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "interpreter"
        ],
        "env" : {

        },
        "first_run" : [
          {
            "file" : "~/.openinterpreter/config.toml",
            "set" : {
              "analytics.enabled" : false,
              "check_for_update_on_startup" : false,
              "features.apps" : false,
              "features.plugins" : false,
              "model" : "grok-build-0.1",
              "model_provider" : "xai",
              "model_providers.xai.base_url" : "https://api.x.ai/v1",
              "model_providers.xai.env_key" : "XAI_API_KEY",
              "model_providers.xai.name" : "xAI",
              "model_providers.xai.wire_api" : "chat",
              "projects.\"/workspace\".trust_level" : "trusted"
            }
          }
        ],
        "model_args" : [
          "-m",
          "$DOZ_MODEL",
          "-c",
          "model_provider=doz",
          "-c",
          "model_providers.doz.name=Dozer",
          "-c",
          "model_providers.doz.base_url=$DOZ_BASE_URL",
          "-c",
          "model_providers.doz.env_key=OPENAI_API_KEY",
          "-c",
          "model_providers.doz.wire_api=chat"
        ],
        "model_args_after" : [
          "exec"
        ],
        "no_prompts_args" : [
          "--dangerously-bypass-approvals-and-sandbox"
        ],
        "passthrough" : [
          "--version",
          "-V",
          "--help",
          "-h",
          "help",
          "exec",
          "e",
          "review",
          "login",
          "logout",
          "mcp",
          "doctor",
          "completion"
        ],
        "resume" : [
          "resume",
          "--last"
        ],
        "state_env" : {
          "CODEX_HOME" : "/home/agent/.openinterpreter"
        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "interpreter",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Open Interpreter's provider settings given on its command line (-c model_provider and model_providers.doz: the chosen source's base URL, the key's placeholder read from OPENAI_API_KEY; -m the model); on xAI (the default) the model is grok-build-0.1.",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "Open Interpreter through OpenAI: doz try open-interpreter --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "Open Interpreter through Google AI: doz try open-interpreter --provider google (or choose it in the try setup); the model with --model.",
            "provider" : "google"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "Open Interpreter through OpenRouter: doz try open-interpreter --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://vercel.com/docs/ai-gateway/authentication-and-byok",
            "kind" : "api-key",
            "note" : "Open Interpreter through Vercel AI Gateway: doz try open-interpreter --gateway vercel-ai-gateway (or choose it in the try setup); the model with --model.",
            "provider" : "vercel-ai-gateway"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "level" : "verified"
          },
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in Vercel AI Gateway (doz try with --gateway vercel-ai-gateway; models@1)",
            "gateway" : "vercel-ai-gateway",
            "level" : "verified"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "models" : {
          "xai" : "grok-build-0.1"
        },
        "shapes" : [
          {
            "env" : {
              "DOZ_BASE_URL" : "${{ dozer.base_url }}",
              "DOZ_MODEL" : "${{ dozer.model }}"
            },
            "key_env" : [
              "OPENAI_API_KEY"
            ],
            "shape" : "openai-chat",
            "source" : "https://github.com/openinterpreter/open-interpreter#configuration"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "interpreter",
          "openinterpreter"
        ],
        "categories" : [
          "coding-agent",
          "personal-agent"
        ],
        "default_base" : "debian",
        "icon" : "open-interpreter",
        "kind" : "coding-agent",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: interpreter exec printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "interpreter exec --skip-git-repo-check \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default)."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/openinterpreter/openinterpreter",
        "intro" : "Open Interpreter is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "interpreter exec --skip-git-repo-check \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "interpreter exec --skip-git-repo-check \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "Open Interpreter, rebuilt as a Codex CLI derivative, on the key of the provider or gateway you choose (xAI by default).",
  "displayName" : "Open Interpreter",
  "id" : "openinterpreter/open-interpreter",
  "kind" : "workload",
  "licenses" : [
    "Apache-2.0"
  ],
  "provides" : [
    "com.dozersandbox/open-interpreter@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/openinterpreter/openinterpreter"
}
