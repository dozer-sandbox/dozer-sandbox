{
  "args" : {
    "version" : {
      "buildArg" : "TGPT_VERSION",
      "default" : "2.15.0",
      "description" : "The tgpt release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+(\\.[0-9]+)?([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "aandrew-me",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "generativelanguage.googleapis.com"
              }
            ],
            "id" : "model:tgpt",
            "phrase" : "talk to your AI model (Google AI)",
            "summary" : "tgpt's model (the Gemini API, with an API key) — needed for tgpt to answer.",
            "title" : "Talk to Google AI"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "generativelanguage.googleapis.com:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "generativelanguage.googleapis.com",
              "format" : "%s",
              "header" : "x-goog-api-key"
            }
          ],
          "name" : "GEMINI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "google"
      },
      "description" : "Google AI (Gemini API) API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.config/tgpt"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "tgpt",
        "integrity" : "sha512-EcCxUb8C5DTvpeY7PpRxbOQFOBL6875cweRzAokS4aY0/m3pHKvS2+g6niA4SlqzT8G1Wp7SGGxxUezmH8rv4w==",
        "kind" : "release-binary",
        "url" : "https://github.com/aandrew-me/tgpt/releases/download/v${{ kit.args.version }}/tgpt-linux-arm64"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "tgpt",
            "-q",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "tgpt",
          "-i"
        ],
        "env" : {
          "AI_PROVIDER" : "gemini",
          "GEMINI_MODEL" : "gemini-2.5-flash"
        },
        "no_prompts_args" : [

        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "tgpt",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "tgpt is set to its Gemini provider (AI_PROVIDER=gemini, GEMINI_MODEL=gemini-2.5-flash), which reads GEMINI_API_KEY and calls the Gemini API's OpenAI-compatible endpoint with a Bearer header; Dozer's proxy sends the key there as x-goog-api-key (checked against a stand-in, not yet against Google). Its key-less free providers reach third-party services Dozer does not allow by default.",
            "provider" : "google"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "gateway" : "openrouter",
            "level" : "unknown",
            "reason" : "not checked against tgpt"
          },
          {
            "checked" : "2026-10-14",
            "gateway" : "vercel-ai-gateway",
            "level" : "unknown",
            "reason" : "not checked against tgpt"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "categories" : [
          "terminal-tool"
        ],
        "default_base" : "debian",
        "icon" : "tgpt",
        "kind" : "ai-tool",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "A2 VM proof: its check turn answered DOZ_FAKE_OK through the fake provider (make recipe-check; probes/617-*/recipes/tgpt)",
            "level" : "verified",
            "notes" : [
              "tgpt -q PROMPT"
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your Gemini API key — a key from aistudio.google.com."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/aandrew-me/tgpt",
        "intro" : "tgpt is a small terminal chat: its session on the left is its interactive mode, and `tgpt -q` answers one question.",
        "steps" : [
          {
            "command" : "tgpt -q \"say ok\"",
            "text" : "Check it answers."
          },
          {
            "text" : "Chat in its session on the left."
          },
          {
            "command" : "tgpt -q \"what is a sandbox, in one line?\"",
            "text" : "One question, quietly."
          }
        ],
        "tips" : [
          "Its key-less free providers are other companies' services, which Dozer does not allow by default."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "A small terminal chat client for many AI providers, set up on a Gemini API key.",
  "displayName" : "tgpt",
  "id" : "aandrew-me/tgpt",
  "kind" : "workload",
  "licenses" : [
    "GPL-3.0-only"
  ],
  "provides" : [
    "com.dozersandbox/tgpt@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/aandrew-me/tgpt"
}
