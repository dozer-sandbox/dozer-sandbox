{
  "args" : {
    "version" : {
      "buildArg" : "TGPT_VERSION",
      "default" : "2.15.0",
      "description" : "The tgpt release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+(\\.[0-9]+)?([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "aandrew-me",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:tgpt",
            "phrase" : "talk to your AI model",
            "summary" : "tgpt's model — the provider or gateway its key is for (OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for tgpt to answer.",
            "title" : "Talk to its model provider"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "generativelanguage.googleapis.com",
              "format" : "%s",
              "header" : "x-goog-api-key"
            }
          ],
          "name" : "GEMINI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "google"
      },
      "description" : "Google AI (Gemini API) API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.config/tgpt"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "tgpt",
        "integrity" : "sha512-EcCxUb8C5DTvpeY7PpRxbOQFOBL6875cweRzAokS4aY0/m3pHKvS2+g6niA4SlqzT8G1Wp7SGGxxUezmH8rv4w==",
        "kind" : "release-binary",
        "url" : "https://github.com/aandrew-me/tgpt/releases/download/v${{ kit.args.version }}/tgpt-linux-arm64"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "tgpt",
            "-q",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "tgpt",
          "-i"
        ],
        "env" : {

        },
        "no_prompts_args" : [

        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "tgpt",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "tgpt's Gemini provider on Google AI (the default: AI_PROVIDER=gemini, GEMINI_MODEL gemini-2.5-flash); its OpenAI provider for the others (OPENAI_URL at the chosen source's chat endpoint, OPENAI_MODEL; the key's placeholder under OPENAI_API_KEY).",
            "provider" : "google"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "tgpt through OpenAI: doz try tgpt --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "tgpt through xAI: doz try tgpt --provider xai (or choose it in the try setup); the model with --model.",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "tgpt through OpenRouter: doz try tgpt --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://vercel.com/docs/ai-gateway/authentication-and-byok",
            "kind" : "api-key",
            "note" : "tgpt through Vercel AI Gateway: doz try tgpt --gateway vercel-ai-gateway (or choose it in the try setup); the model with --model.",
            "provider" : "vercel-ai-gateway"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "level" : "verified"
          },
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in Vercel AI Gateway (doz try with --gateway vercel-ai-gateway; models@1)",
            "gateway" : "vercel-ai-gateway",
            "level" : "verified"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "google",
        "native" : [
          {
            "env" : {
              "AI_PROVIDER" : "gemini",
              "GEMINI_MODEL" : "${{ dozer.model }}"
            },
            "source" : "google"
          }
        ],
        "shapes" : [
          {
            "env" : {
              "AI_PROVIDER" : "openai",
              "OPENAI_MODEL" : "${{ dozer.model }}",
              "OPENAI_URL" : "${{ dozer.base_url }}/chat/completions"
            },
            "key_env" : [
              "OPENAI_API_KEY"
            ],
            "shape" : "openai-chat",
            "source" : "https://github.com/aandrew-me/tgpt#readme"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "categories" : [
          "terminal-tool"
        ],
        "default_base" : "debian",
        "icon" : "tgpt",
        "kind" : "ai-tool",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "A2 VM proof: its check turn answered DOZ_FAKE_OK through the fake provider (make recipe-check; probes/617-*/recipes/tgpt)",
            "level" : "verified",
            "notes" : [
              "tgpt -q PROMPT"
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (Google AI by default)."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/aandrew-me/tgpt",
        "intro" : "tgpt is a small terminal chat: its session on the left is its interactive mode, and `tgpt -q` answers one question.",
        "steps" : [
          {
            "command" : "tgpt -q \"say ok\"",
            "text" : "Check it answers."
          },
          {
            "text" : "Chat in its session on the left."
          },
          {
            "command" : "tgpt -q \"what is a sandbox, in one line?\"",
            "text" : "One question, quietly."
          }
        ],
        "tips" : [
          "Its key-less free providers are other companies' services, which Dozer does not allow by default."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "A small terminal chat client for many AI providers, on the key of the provider or gateway you choose (Google AI by default).",
  "displayName" : "tgpt",
  "id" : "aandrew-me/tgpt",
  "kind" : "workload",
  "licenses" : [
    "GPL-3.0-only"
  ],
  "provides" : [
    "com.dozersandbox/tgpt@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/aandrew-me/tgpt"
}
