{
  "args" : {
    "version" : {
      "buildArg" : "ZEROCLAW_VERSION",
      "default" : "0.8.5",
      "description" : "The ZeroClaw release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+(\\.[0-9]+)?([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "ZeroClaw",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:zeroclaw",
            "phrase" : "talk to your AI model",
            "summary" : "ZeroClaw's model — the provider or gateway its key is for (OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for ZeroClaw to answer.",
            "title" : "Talk to its model provider"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.zeroclaw"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "zeroclaw",
        "integrity" : "sha512-z05xgONSrtERDekKh7jpbQuSrKNq2e9W2Zux3W5gDw3z9zKZyW6QHUpA9dGU3do4spzNTDSfeR1PtNjsX5lCmQ==",
        "kind" : "release-binary",
        "payload" : "zeroclaw",
        "url" : "https://github.com/zeroclaw-labs/zeroclaw/releases/download/v${{ kit.args.version }}/zeroclaw-aarch64-unknown-linux-gnu.tar.gz"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "zeroclaw",
            "agent",
            "-a",
            "main",
            "-m",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "zeroclaw",
          "agent",
          "-a",
          "main"
        ],
        "env" : {

        },
        "first_run" : [
          {
            "file" : "~/.zeroclaw/config.toml",
            "set" : {
              "agents.main.model_provider" : "openai.xai",
              "agents.main.risk_profile" : "default",
              "providers.models.openai.xai.model" : "grok-4-1-fast",
              "providers.models.openai.xai.uri" : "https://api.x.ai/v1",
              "risk_profiles.default.level" : "full",
              "schema_version" : 3
            }
          }
        ],
        "no_prompts_args" : [

        ],
        "passthrough" : [
          "--version",
          "--help",
          "-h",
          "config",
          "quickstart",
          "auth"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "zeroclaw",
              "--version"
            ],
            "expect" : "zeroclaw ${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "ZeroClaw is set up with one OpenAI-shaped provider and one agent, main, at full autonomy (the sandbox is the boundary); Dozer points the provider at the chosen source (its uri, model and key through ZeroClaw's own environment overrides).",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "ZeroClaw through OpenAI: doz try zeroclaw --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "ZeroClaw through Google AI: doz try zeroclaw --provider google (or choose it in the try setup); the model with --model.",
            "provider" : "google"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "ZeroClaw through OpenRouter: doz try zeroclaw --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://vercel.com/docs/ai-gateway/authentication-and-byok",
            "kind" : "api-key",
            "note" : "ZeroClaw through Vercel AI Gateway: doz try zeroclaw --gateway vercel-ai-gateway (or choose it in the try setup); the model with --model.",
            "provider" : "vercel-ai-gateway"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "endpoint" : "v1",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "how" : {
              "env" : {
                "ZEROCLAW_providers__models__openai__xai__model" : "${{ dozer.model }}",
                "ZEROCLAW_providers__models__openai__xai__uri" : "${{ dozer.gateway.endpoint.v1 }}"
              }
            },
            "level" : "verified",
            "shape" : "openai-chat"
          },
          {
            "checked" : "2026-10-14",
            "endpoint" : "v1",
            "evidence" : "make recipe-check: its check turn through a stand-in Vercel AI Gateway (doz try with --gateway vercel-ai-gateway; models@1)",
            "gateway" : "vercel-ai-gateway",
            "how" : {
              "env" : {
                "ZEROCLAW_providers__models__openai__xai__model" : "${{ dozer.model }}",
                "ZEROCLAW_providers__models__openai__xai__uri" : "${{ dozer.gateway.endpoint.v1 }}"
              }
            },
            "level" : "verified",
            "shape" : "openai-chat"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "shapes" : [
          {
            "env" : {
              "ZEROCLAW_providers__models__openai__xai__model" : "${{ dozer.model }}",
              "ZEROCLAW_providers__models__openai__xai__uri" : "${{ dozer.base_url }}"
            },
            "key_env" : [
              "ZEROCLAW_providers__models__openai__xai__api_key"
            ],
            "shape" : "openai-chat"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "categories" : [
          "personal-agent"
        ],
        "default_base" : "debian",
        "icon" : "zeroclaw",
        "kind" : "ai-tool",
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "A2 VM proof: its check turn answered DOZ_FAKE_OK through the fake provider (make recipe-check; probes/617-*/recipes/zeroclaw)",
            "level" : "verified",
            "notes" : [
              "zeroclaw agent -a main -m PROMPT"
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default). Its gateway, web dashboard and chat channels need a background service and a forwarded port, which Dozer does not offer yet."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/zeroclaw-labs/zeroclaw",
        "intro" : "ZeroClaw is a personal-agent runtime with shell, file and web tools; its session on the left is its agent, main, at full autonomy.",
        "steps" : [
          {
            "command" : "zeroclaw agent -a main -m \"say ok\"",
            "text" : "Check it answers."
          },
          {
            "text" : "Talk to it in its session on the left."
          },
          {
            "command" : "zeroclaw agent -a main -m \"what can you do?\"",
            "text" : "One message without the session."
          }
        ],
        "tips" : [
          "Its settings are `~/.zeroclaw/config.toml` (kept on the sandbox's state disk)."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "A Rust personal-agent runtime with shell, file and web tools; its terminal agent on an xAI, OpenAI, Google AI, OpenRouter or Vercel AI Gateway key.",
  "displayName" : "ZeroClaw",
  "id" : "zeroclaw-labs/zeroclaw",
  "kind" : "workload",
  "licenses" : [
    "Apache-2.0"
  ],
  "provides" : [
    "com.dozersandbox/zeroclaw@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/zeroclaw-labs/zeroclaw"
}
