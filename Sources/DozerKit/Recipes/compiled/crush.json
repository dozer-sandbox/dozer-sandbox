{
  "args" : {
    "version" : {
      "buildArg" : "CRUSH_VERSION",
      "default" : "0.98.1",
      "description" : "The Crush release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Charmbracelet",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/chat/completions"
                ]
              }
            ],
            "id" : "model:crush",
            "phrase" : "talk to your AI model (xAI)",
            "summary" : "Crush's model here (the xAI API, with your key) — needed for it to answer.",
            "title" : "Talk to xAI"
          },
          "update" : [

          ],
          "vendor" : [
            {
              "host" : "api.github.com",
              "paths" : [
                "/repos/charmbracelet/crush/releases/latest"
              ],
              "reason" : "Crush asks GitHub for its latest release at each run (read-only; no setting turns it off) and only shows a notice"
            }
          ]
        },
        "runtime" : {
          "allow" : [
            "api.x.ai:443",
            "api.github.com:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.config/crush"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.local/share/crush"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "crush",
        "integrity" : "sha512-VbfBLF8cxG8tzN4xTkFwCmzcTYSYAbnMNNKs8y+tQGJzKWnj9QsXFRtD7m+pfvtfe0sqixU6ttLtx1Doc7MFFg==",
        "kind" : "release-binary",
        "payload" : "crush_0.98.1_Linux_arm64/crush",
        "url" : "https://github.com/charmbracelet/crush/releases/download/v${{ kit.args.version }}/crush_${{ kit.args.version }}_Linux_arm64.tar.gz"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "crush",
            "run",
            "-q",
            "-m",
            "xai/grok-build-0.1",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "crush"
        ],
        "env" : {
          "CRUSH_DISABLE_METRICS" : "1",
          "CRUSH_DISABLE_PROVIDER_AUTO_UPDATE" : "1"
        },
        "first_run" : [
          {
            "file" : "~/.config/crush/crush.json",
            "set" : {
              "models.large.model" : "grok-build-0.1",
              "models.large.provider" : "xai",
              "models.small.model" : "grok-build-0.1",
              "models.small.provider" : "xai",
              "options.disable_metrics" : true,
              "options.disable_provider_auto_update" : true
            }
          }
        ],
        "no_prompts_args" : [
          "--yolo"
        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h",
          "help",
          "run",
          "dirs",
          "logs",
          "models",
          "session",
          "stats",
          "login",
          "logout",
          "update-providers"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "crush",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Crush's built-in xai provider reads XAI_API_KEY; its large and small models set to grok-build-0.1. Its own sign-in (Charm, Hyper) is not used.",
            "provider" : "xai"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "gateway" : "openrouter",
            "level" : "unknown",
            "reason" : "Crush has an OpenRouter provider; not checked"
          },
          {
            "checked" : "2026-10-14",
            "gateway" : "vercel-ai-gateway",
            "level" : "unknown",
            "reason" : "not checked against Crush"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "debian",
        "icon" : "crush",
        "kind" : "coding-agent",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: crush run \"say ok\" printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "crush run -q -m xai/grok-build-0.1 \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your xAI API key — a key from console.x.ai. Crush is under the FSL-1.1-MIT licence (each release becomes MIT two years on)."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/charmbracelet/crush",
        "intro" : "Crush is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "crush run -q -m xai/grok-build-0.1 \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "crush run -q -m xai/grok-build-0.1 \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "Charmbracelet's coding agent for the terminal, here on an xAI API key.",
  "displayName" : "Crush",
  "id" : "charmbracelet/crush",
  "kind" : "workload",
  "licenses" : [
    "FSL-1.1-MIT"
  ],
  "provides" : [
    "com.dozersandbox/crush@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/charmbracelet/crush"
}
