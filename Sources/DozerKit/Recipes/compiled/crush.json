{
  "args" : {
    "version" : {
      "buildArg" : "CRUSH_VERSION",
      "default" : "0.98.1",
      "description" : "The Crush release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Charmbracelet",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.anthropic.com",
                "reason" : "Anthropic — when the sandbox's key is Anthropic's"
              },
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/chat/completions"
                ],
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:crush",
            "phrase" : "talk to your AI model",
            "summary" : "Crush's model — the provider or gateway its key is for (Anthropic, OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for Crush to answer.",
            "title" : "Talk to its model provider"
          },
          "update" : [

          ],
          "vendor" : [
            {
              "host" : "api.github.com",
              "paths" : [
                "/repos/charmbracelet/crush/releases/latest"
              ],
              "reason" : "Crush asks GitHub for its latest release at each run (read-only; no setting turns it off) and only shows a notice"
            }
          ]
        },
        "runtime" : {
          "allow" : [
            "api.anthropic.com:443",
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443",
            "api.github.com:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.config/crush"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.local/share/crush"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "crush",
        "integrity" : "sha512-VbfBLF8cxG8tzN4xTkFwCmzcTYSYAbnMNNKs8y+tQGJzKWnj9QsXFRtD7m+pfvtfe0sqixU6ttLtx1Doc7MFFg==",
        "kind" : "release-binary",
        "payload" : "crush_0.98.1_Linux_arm64/crush",
        "url" : "https://github.com/charmbracelet/crush/releases/download/v${{ kit.args.version }}/crush_${{ kit.args.version }}_Linux_arm64.tar.gz"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "crush",
            "run",
            "-q",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "crush"
        ],
        "env" : {
          "CRUSH_DISABLE_METRICS" : "1",
          "CRUSH_DISABLE_PROVIDER_AUTO_UPDATE" : "1"
        },
        "first_run" : [
          {
            "file" : "~/.config/crush/crush.json",
            "set" : {
              "models.large.model" : "grok-build-0.1",
              "models.large.provider" : "xai",
              "models.small.model" : "grok-build-0.1",
              "models.small.provider" : "xai",
              "options.disable_metrics" : true,
              "options.disable_provider_auto_update" : true
            }
          },
          {
            "each_run" : true,
            "file" : "~/.config/crush/crush.json",
            "set" : {
              "models.large.model" : "$DOZ_MODEL",
              "models.large.provider" : "doz",
              "models.small.model" : "$DOZ_MODEL",
              "models.small.provider" : "doz",
              "providers.doz.api_key" : "$DOZ_KEY_REF",
              "providers.doz.base_url" : "$DOZ_BASE_URL",
              "providers.doz.models" : [
                {
                  "context_window" : 200000,
                  "default_max_tokens" : 8192,
                  "id" : "$DOZ_MODEL",
                  "name" : "$DOZ_MODEL"
                }
              ],
              "providers.doz.name" : "Dozer",
              "providers.doz.type" : "$DOZ_CRUSH_TYPE"
            }
          }
        ],
        "no_prompts_args" : [
          "--yolo"
        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h",
          "help",
          "run",
          "dirs",
          "logs",
          "models",
          "session",
          "stats",
          "login",
          "logout",
          "update-providers"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "crush",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Crush's model and provider are set in its settings file at every run (~/.config/crush/crush.json: one provider at the chosen source's base URL, OpenAI-compatible or Anthropic; its key read from the variable the placeholder is in, never written there). On xAI (the default) the model is grok-build-0.1. Its own sign-in (Charm, Hyper) is not used.",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "api-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.anthropic.com/settings/keys",
            "kind" : "api-key",
            "note" : "Crush through Anthropic: doz try crush --provider anthropic (or choose it in the try setup); the model with --model.",
            "provider" : "anthropic"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "Crush through OpenAI: doz try crush --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "Crush through Google AI: doz try crush --provider google (or choose it in the try setup); the model with --model.",
            "provider" : "google"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "Crush through OpenRouter: doz try crush --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://vercel.com/docs/ai-gateway/authentication-and-byok",
            "kind" : "api-key",
            "note" : "Crush through Vercel AI Gateway: doz try crush --gateway vercel-ai-gateway (or choose it in the try setup); the model with --model.",
            "provider" : "vercel-ai-gateway"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "level" : "verified"
          },
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in Vercel AI Gateway (doz try with --gateway vercel-ai-gateway; models@1)",
            "gateway" : "vercel-ai-gateway",
            "level" : "verified"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "models" : {
          "xai" : "grok-build-0.1"
        },
        "shapes" : [
          {
            "env" : {
              "DOZ_BASE_URL" : "${{ dozer.base_url }}",
              "DOZ_CRUSH_TYPE" : "openai-compat",
              "DOZ_KEY_REF" : "$OPENAI_API_KEY",
              "DOZ_MODEL" : "${{ dozer.model }}"
            },
            "key_env" : [
              "OPENAI_API_KEY"
            ],
            "shape" : "openai-chat",
            "source" : "https://github.com/charmbracelet/crush#custom-providers"
          },
          {
            "env" : {
              "DOZ_BASE_URL" : "${{ dozer.base_url }}",
              "DOZ_CRUSH_TYPE" : "anthropic",
              "DOZ_KEY_REF" : "$ANTHROPIC_API_KEY",
              "DOZ_MODEL" : "${{ dozer.model }}"
            },
            "key_env" : [
              "ANTHROPIC_API_KEY"
            ],
            "shape" : "anthropic-messages",
            "source" : "https://github.com/charmbracelet/crush#custom-providers"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "debian",
        "icon" : "crush",
        "kind" : "coding-agent",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: crush run \"say ok\" printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "crush run -q \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default). Crush is under the FSL-1.1-MIT licence (each release becomes MIT two years on)."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/charmbracelet/crush",
        "intro" : "Crush is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "crush run -q \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "crush run -q \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "Charmbracelet's coding agent for the terminal, on the key of the provider or gateway you choose (xAI by default).",
  "displayName" : "Crush",
  "id" : "charmbracelet/crush",
  "kind" : "workload",
  "licenses" : [
    "FSL-1.1-MIT"
  ],
  "provides" : [
    "com.dozersandbox/crush@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/charmbracelet/crush"
}
