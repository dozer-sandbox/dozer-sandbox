{
  "args" : {
    "version" : {
      "buildArg" : "NANOBOT_VERSION",
      "default" : "0.3.5",
      "description" : "The nanobot release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+(\\.[0-9]+)?([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "HKU Data Intelligence Lab",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:nanobot",
            "phrase" : "talk to your AI model",
            "summary" : "nanobot's model — the provider or gateway its key is for (OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for nanobot to answer.",
            "title" : "Talk to its model provider"
          },
          "update" : [

          ],
          "vendor" : [
            {
              "host" : "openaipublic.blob.core.windows.net",
              "paths" : [
                "/encodings/"
              ],
              "reason" : "tiktoken (a library nanobot uses to count tokens) downloads its tokenizer files from OpenAI's public blob store at the first turn"
            }
          ]
        },
        "runtime" : {
          "allow" : [
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443",
            "openaipublic.blob.core.windows.net:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
