    {
      "config" : {
        "check" : {
          "argv" : [
            "nanobot",
            "agent",
            "-m",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "nanobot"
        ],
        "env" : {

        },
        "first_run" : [
          {
            "file" : "~/.nanobot/config.json",
            "set" : {
              "agents.defaults.modelPreset" : "primary",
              "modelPresets.primary.model" : "${DOZ_MODEL}",
              "modelPresets.primary.provider" : "custom",
              "providers.custom.apiBase" : "${DOZ_MODEL_BASE_URL}",
              "providers.custom.apiKey" : "${DOZ_MODEL_API_KEY}"
            }
          }
        ],
        "no_prompts_args" : [

        ],
        "passthrough" : [
          "--version",
          "--help",
          "-h",
          "onboard",
          "status",
          "provider"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "nanobot",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
