{
  "args" : {
    "version" : {
      "buildArg" : "GROK_VERSION",
      "default" : "1.0.52",
      "description" : "The Grok Build release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "xAI",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [
            "cli-chat-proxy.grok.com",
            "auth.x.ai",
            "accounts.x.ai",
            "console.x.ai"
          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/models",
                  "/v1/api-key",
                  "/v1/chat/completions",
                  "/v1/responses"
                ]
              },
              {
                "exact_paths" : [
                  "/"
                ],
                "host" : "api.x.ai",
                "reason" : "Grok Build checks that the xAI API answers when it starts (GET /, no key sent)"
              },
              {
                "host" : "x.ai",
                "reason" : "Grok Build reads its release notes on xAI's own site (x.ai/cli/changelogs) when it starts"
              }
            ],
            "id" : "model:xai",
            "phrase" : "talk to your AI model (xAI)",
            "summary" : "Grok Build's model (the xAI API) — needed for Grok Build to work.",
            "title" : "Talk to xAI"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.x.ai:443",
            "x.ai:443"
          ],
          "deny" : [
            "cli-chat-proxy.grok.com:443",
            "auth.x.ai:443",
            "accounts.x.ai:443",
            "console.x.ai:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.grok"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "directory" : "/home/agent/.grok/rules",
        "dozer" : {
          "kind" : "context-file"
        },
        "filename" : "dozer.md"
      },
      "type" : "com.docker.sandbox/agent-context@1"
    },
    {
      "config" : {
        "binary" : "grok",
        "compression" : "brotli",
        "integrity" : "sha512-aweQyHPi5r+qMG0BUp1XH22R7RGeQNYhqQMpePlsjyGesd5/v79HQPs9PIkKLjrcX4uz5cFFe8RcnkKu5J5zCA==",
        "kind" : "npm-platform-binary",
        "package" : "@xai-official/grok",
        "payload" : "bin/grok.br",
        "platform_package" : "@xai-official/grok-linux-arm64"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "grok",
            "-p",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "grok"
        ],
        "env" : {
          "GROK_DISABLE_AUTOUPDATER" : "1"
        },
        "first_run" : [
          {
            "file" : "~/.grok/config.toml",
            "set" : {
              "cli.auto_update" : false,
              "features.feedback" : false,
              "features.telemetry" : false,
              "telemetry.trace_upload" : false
            }
          }
        ],
        "no_prompts_args" : [
          "--always-approve"
        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h",
          "login",
          "logout",
          "mcp",
          "models",
          "doctor",
          "version",
          "update",
          "agent",
          "completions",
          "inspect",
          "sessions",
          "export",
          "usage",
          "du"
        ],
        "state_env" : {
          "GROK_HOME" : "/home/agent/.grok"
        },
        "status" : "osc7501",
        "verify" : [
          {
            "argv" : [
              "grok",
              "--version"
            ],
            "expect" : "grok ${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-12",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "provider" : "xai"
          },
          {
            "account" : "an x.ai or X account",
            "checked" : "2026-10-12",
            "in_sandbox" : false,
            "kind" : "vendor-sign-in",
            "note" : "Grok Build signs in itself (grok login, or grok login --device-code without a browser). That sign-in would live in the sandbox's own state (~/.grok), not on the Mac — Dozer does not offer it yet."
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-12",
            "endpoint" : "v1",
            "evidence" : "xAI's custom-models guide says any OpenAI Chat Completions or Responses server works through GROK_MODELS_BASE_URL (+ XAI_API_KEY); Dozer's step-0 run (617.01 §1.3) saw Grok Build 1.0.50 honour GROK_XAI_API_BASE_URL / GROK_MODELS_BASE_URL against a local OpenAI-compatible fake — evidence the variables are read, not a run against OpenRouter",
            "gateway" : "openrouter",
            "how" : {
              "config" : [
                {
                  "file" : "~/.grok/config.toml",
                  "set" : {
                    "models.default" : "${{ dozer.model }}"
                  }
                }
              ],
              "env" : {
                "GROK_MODELS_BASE_URL" : "${{ dozer.gateway.endpoint.v1 }}",
                "XAI_API_KEY" : "${{ dozer.placeholder }}"
              }
            },
            "level" : "experimental",
            "limits" : [
              "not supported by xAI or OpenRouter for this pair: an opt-in only"
            ],
            "proxy_route" : {
              "from_host" : "api.x.ai",
              "paths" : {
                "/v1/chat/completions" : "/api/v1/chat/completions",
                "/v1/models" : "/api/v1/models",
                "/v1/responses" : "/api/v1/responses"
              },
              "unmapped" : [
                "/v1/api-key"
              ]
            },
            "shape" : "openai-chat",
            "source" : "https://github.com/xai-org/grok-build/blob/main/crates/codegen/xai-grok-pager/docs/user-guide/11-custom-models.md"
          },
          {
            "checked" : "2026-10-12",
            "endpoint" : "coding-agent",
            "gateway" : "vercel-ai-gateway",
            "how" : {
              "config" : [
                {
                  "file" : "~/.grok/config.toml",
                  "set" : {
                    "models.default" : "${{ dozer.model }}"
                  }
                }
              ],
              "env" : {
                "GROK_CODE_XAI_API_KEY" : "${{ dozer.placeholder }}",
                "GROK_MODELS_BASE_URL" : "${{ dozer.gateway.endpoint.coding-agent }}"
              }
            },
            "level" : "documented",
            "limits" : [
              "a grok login session takes precedence over the key: grok logout first",
              "web search needs a second, Responses-backed model entry"
            ],
            "notes" : [
              "Ctrl+M lists the gateway's /v1/models"
            ],
            "shape" : "openai-chat",
            "source" : "https://vercel.com/docs/ai-gateway/coding-agents/grok-build"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-12"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "debian",
        "icon" : "grok-build",
        "kind" : "coding-agent",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-12",
            "evidence" : "617 step 0: grok -p \"say ok\" printed the fake's answer and exited in a sandbox (617.01 §1.3)",
            "level" : "verified",
            "notes" : [
              "grok -p / --single"
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your xAI API key — a key from console.x.ai. When Dozer has no key for it, Grok Build says \"Not signed in\"."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/xai-org/grok-build",
        "intro" : "Grok Build is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "grok -p \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "grok -p \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "xAI's coding agent, on an xAI API key.",
  "displayName" : "Grok Build",
  "id" : "xai/grok",
  "kind" : "workload",
  "licenses" : [
    "Apache-2.0"
  ],
  "provides" : [
    "com.dozersandbox/grok@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/xai-org/grok-build"
}
