{
  "args" : {
    "version" : {
      "buildArg" : "MAKI_VERSION",
      "default" : "0.6.3",
      "description" : "The Maki release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Tony Solomonik and contributors",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.anthropic.com",
                "reason" : "Anthropic — when the sandbox's key is Anthropic's"
              },
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/models",
                  "/v1/chat/completions"
                ],
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              }
            ],
            "id" : "model:maki",
            "phrase" : "talk to your AI model",
            "summary" : "Maki's model — the provider or gateway its key is for (Anthropic, OpenAI, xAI or OpenRouter), with an API key. Needed for Maki to answer.",
            "title" : "Talk to its model provider"
          },
          "quiet" : [
            {
              "host" : "models.dev",
              "reason" : "Maki's TUI fetches the public models.dev catalogue when it starts (cached a day); with its model named it does without it when refused"
            }
          ],
          "update" : [

          ],
          "vendor" : [
            {
              "host" : "api.github.com",
              "paths" : [
                "/repos/tontinton/maki/releases/latest"
              ],
              "reason" : "Maki's TUI asks GitHub for its latest release when it starts (read-only; no setting turns it off) and only shows a notice"
            }
          ]
        },
        "runtime" : {
          "allow" : [
            "api.anthropic.com:443",
            "api.openai.com:443",
            "api.x.ai:443",
            "openrouter.ai:443",
            "api.github.com:443"
          ],
          "deny" : [
            "models.dev:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.config/maki"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.local/state/maki"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "maki",
        "integrity" : "sha512-EvaWRSZieLvjTQGM83oAAUl8OsC9qwwvRKRsUt6UGk7o+aKVUM4CYOMgLS60chUWcv1WG2T2xQ5yaksD6Xmsww==",
        "kind" : "release-binary",
        "payload" : "maki",
        "url" : "https://github.com/tontinton/maki/releases/download/v${{ kit.args.version }}/maki-v${{ kit.args.version }}-aarch64-unknown-linux-musl.tar.gz"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "maki",
            "-p",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "maki"
        ],
        "env" : {

        },
        "model_args" : [
          "-m",
          "$DOZ_MODEL"
        ],
        "no_prompts_args" : [
          "--yolo"
        ],
        "passthrough" : [
          "--version",
          "-V",
          "--help",
          "-h",
          "help",
          "auth",
          "models",
          "session",
          "mcp",
          "update",
          "trust",
          "-p",
          "--print"
        ],
        "resume" : [
          "--continue"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "maki",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Maki's own providers, each reading its key from the environment; Dozer puts the model on its command line (-m xai/grok-build-0.1 on xAI, the default; -m PROVIDER/MODEL for the others).",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "api-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.anthropic.com/settings/keys",
            "kind" : "api-key",
            "note" : "Maki through Anthropic: doz try maki --provider anthropic (or choose it in the try setup); the model with --model.",
            "provider" : "anthropic"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "Maki through OpenAI: doz try maki --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "Maki through OpenRouter: doz try maki --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "level" : "verified"
          },
          {
            "checked" : "2026-10-16",
            "gateway" : "vercel-ai-gateway",
            "level" : "no",
            "reason" : "Maki has no Vercel AI Gateway provider of its own; a custom one needs its providers.toml"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "models" : {
          "xai" : "grok-build-0.1"
        },
        "native" : [
          {
            "env" : {
              "DOZ_MODEL" : "anthropic/${{ dozer.model }}"
            },
            "source" : "anthropic"
          },
          {
            "env" : {
              "DOZ_MODEL" : "openai/${{ dozer.model }}"
            },
            "source" : "openai"
          },
          {
            "env" : {
              "DOZ_MODEL" : "xai/${{ dozer.model }}"
            },
            "source" : "xai"
          },
          {
            "docs" : "https://github.com/tontinton/maki#providers",
            "env" : {
              "DOZ_MODEL" : "openrouter/${{ dozer.model }}"
            },
            "source" : "openrouter"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "debian",
        "icon" : "maki",
        "kind" : "coding-agent",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: maki -p \"say ok\" printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "maki -p \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default)."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/tontinton/maki",
        "intro" : "Maki is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "maki -p \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "maki -p \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "A Rust coding agent for the terminal with Lua plugins, on the key of the provider or gateway you choose (xAI by default).",
  "displayName" : "Maki",
  "id" : "tontinton/maki",
  "kind" : "workload",
  "licenses" : [
    "MIT"
  ],
  "provides" : [
    "com.dozersandbox/maki@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/tontinton/maki"
}
