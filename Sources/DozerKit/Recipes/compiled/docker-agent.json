{
  "args" : {
    "version" : {
      "buildArg" : "DOCKER_AGENT_VERSION",
      "default" : "1.150.0",
      "description" : "The Docker Agent release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Docker",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.anthropic.com",
                "reason" : "Anthropic — when the sandbox's key is Anthropic's"
              },
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/chat/completions"
                ],
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:docker-agent",
            "phrase" : "talk to your AI model",
            "summary" : "Docker Agent's model — the provider or gateway its key is for (Anthropic, OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for Docker Agent to answer.",
            "title" : "Talk to its model provider"
          },
          "quiet" : [
            {
              "host" : "models.dev",
              "reason" : "Docker Agent reads the public models.dev catalogue at each run (no setting turns it off); with its model named it does without it when refused"
            }
          ],
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.anthropic.com:443",
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443"
          ],
          "deny" : [
            "models.dev:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.cagent"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.config/cagent"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "docker-agent",
        "integrity" : "sha512-KklBky8+usd4CK6S48S940vZJpxg1wn1cKqmGgJmsfBw3YAkRWusE/nlnDqT4TM0l4Lh/SVPgAvC/d8XQdAVmA==",
        "kind" : "release-binary",
        "url" : "https://github.com/docker/docker-agent/releases/download/v${{ kit.args.version }}/docker-agent-linux-arm64"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "docker-agent",
            "run",
            "coder",
            "--exec",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "docker-agent",
          "run",
          "coder"
        ],
        "env" : {
          "DOCKER_AGENT_AUTO_UPDATE" : "false",
          "DOCKER_AGENT_HIDE_TELEMETRY_BANNER" : "1",
          "DOCKER_AGENT_NO_SETUP" : "1",
          "DOCKER_AGENT_NO_TOUR" : "1",
          "TELEMETRY_ENABLED" : "false"
        },
        "model_args" : [
          "--model",
          "$DOZ_MODEL"
        ],
        "model_args_after" : [
          "run"
        ],
        "no_prompts_args" : [
          "--yolo"
        ],
        "passthrough" : [
          "--help",
          "-h",
          "help",
          "version",
          "run",
          "models",
          "doctor",
          "setup",
          "sessions",
          "new",
          "eval",
          "alias",
          "toolsets",
          "getting-started"
        ],
        "state_env" : {

        },
        "status" : "osc7501",
        "verify" : [
          {
            "argv" : [
              "docker-agent",
              "version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Docker Agent's own providers, each reading its key from the environment; Dozer puts the model on its run command (--model xai/grok-build-0.1 on xAI, the default; --model PROVIDER/MODEL for the others).",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "api-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.anthropic.com/settings/keys",
            "kind" : "api-key",
            "note" : "Docker Agent through Anthropic: doz try docker-agent --provider anthropic (or choose it in the try setup); the model with --model.",
            "provider" : "anthropic"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "Docker Agent through OpenAI: doz try docker-agent --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "Docker Agent through Google AI: doz try docker-agent --provider google (or choose it in the try setup); the model with --model.",
            "provider" : "google"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "Docker Agent through OpenRouter: doz try docker-agent --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://vercel.com/docs/ai-gateway/authentication-and-byok",
            "kind" : "api-key",
            "note" : "Docker Agent through Vercel AI Gateway: doz try docker-agent --gateway vercel-ai-gateway (or choose it in the try setup); the model with --model.",
            "provider" : "vercel-ai-gateway"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "level" : "verified"
          },
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in Vercel AI Gateway (doz try with --gateway vercel-ai-gateway; models@1)",
            "gateway" : "vercel-ai-gateway",
            "level" : "verified"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "models" : {
          "xai" : "grok-build-0.1"
        },
        "native" : [
          {
            "env" : {
              "DOZ_MODEL" : "anthropic/${{ dozer.model }}"
            },
            "source" : "anthropic"
          },
          {
            "env" : {
              "DOZ_MODEL" : "openai/${{ dozer.model }}"
            },
            "source" : "openai"
          },
          {
            "env" : {
              "DOZ_MODEL" : "xai/${{ dozer.model }}"
            },
            "source" : "xai"
          },
          {
            "env" : {
              "DOZ_MODEL" : "google/${{ dozer.model }}"
            },
            "key_env" : [
              "GOOGLE_API_KEY"
            ],
            "source" : "google"
          },
          {
            "docs" : "https://docs.docker.com/ai/docker-agent/",
            "env" : {
              "DOZ_MODEL" : "openrouter/${{ dozer.model }}"
            },
            "source" : "openrouter"
          },
          {
            "docs" : "https://docs.docker.com/ai/docker-agent/",
            "env" : {
              "DOZ_MODEL" : "vercel/${{ dozer.model }}"
            },
            "source" : "vercel-ai-gateway"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "cagent"
        ],
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "debian",
        "icon" : "docker-agent",
        "kind" : "coding-agent",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: docker-agent run coder --exec \"say ok\" printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "docker-agent run coder --exec \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default). It runs as a program in the sandbox; Docker Desktop is not used."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/docker/docker-agent",
        "intro" : "Docker Agent is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "docker-agent run coder --exec \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "docker-agent run coder --exec \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "Docker's YAML-defined agent runner (formerly cagent), its built-in coding agent on the key of the provider or gateway you choose (xAI by default).",
  "displayName" : "Docker Agent",
  "id" : "docker/docker-agent",
  "kind" : "workload",
  "licenses" : [
    "Apache-2.0"
  ],
  "provides" : [
    "com.dozersandbox/docker-agent@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/docker/docker-agent"
}
