{
  "args" : {
    "version" : {
      "buildArg" : "DIRAC_VERSION",
      "default" : "0.5.20",
      "description" : "The Dirac release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "dirac-run",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/chat/completions"
                ]
              }
            ],
            "id" : "model:dirac",
            "phrase" : "talk to your AI model (xAI)",
            "summary" : "Dirac's model here (the xAI API, with your key) — needed for it to answer.",
            "title" : "Talk to xAI"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.x.ai:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.dirac"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "binary" : "dirac",
        "integrity" : "sha512-t2sUPPI9APCTHq+Lwr1IOq1OkubRSIrzB3lHJMMaAT+OLVjAGjWhxVIS/3xFCouBvQHB2xQF/jyVb57bbOjJvw==",
        "kind" : "npm",
        "needs_node" : "22",
        "npm_args" : [
          "--ignore-scripts"
        ],
        "package" : "dirac-cli"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "dirac",
            "--yolo",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "dirac"
        ],
        "env" : {
          "DIRAC_NO_AUTO_UPDATE" : "1",
          "DIRAC_PROVIDER" : "xai"
        },
        "first_run" : [
          {
            "file" : "~/.dirac/data/globalState.json",
            "set" : {
              "actModeApiProvider" : "xai",
              "planModeApiProvider" : "xai",
              "telemetrySetting" : "disabled"
            }
          }
        ],
        "no_prompts_args" : [
          "--auto-approve-all"
        ],
        "passthrough" : [
          "--version",
          "-V",
          "--help",
          "-h",
          "help"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "dirac",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Dirac reads XAI_API_KEY with xAI as its provider (actModeApiProvider/planModeApiProvider in its global state for the TUI, DIRAC_PROVIDER for a one-shot run) and picks its own xAI model; its other providers are not offered here yet.",
            "provider" : "xai"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "gateway" : "openrouter",
            "level" : "unknown",
            "reason" : "Dirac reads OPENROUTER_API_KEY; not checked"
          },
          {
            "checked" : "2026-10-14",
            "gateway" : "vercel-ai-gateway",
            "level" : "unknown",
            "reason" : "not checked against Dirac"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "dirac-cli"
        ],
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "node",
        "icon" : "dirac",
        "kind" : "coding-agent",
        "limits" : [
          {
            "musl" : true,
            "reason" : "Dirac needs Node 22.13 to 24; Alpine's Node is older"
          }
        ],
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: dirac --yolo \"say ok\" ended its task with the stand-in's answer in a fresh try",
            "level" : "verified",
            "notes" : [
              "dirac --yolo \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your xAI API key — a key from console.x.ai."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/dirac-run/dirac",
        "intro" : "Dirac is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "dirac --yolo \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "dirac --yolo \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "A Cline-derived coding agent for the terminal, aimed at lower API cost, here on an xAI API key.",
  "displayName" : "Dirac",
  "id" : "dirac-run/dirac",
  "kind" : "workload",
  "licenses" : [
    "Apache-2.0"
  ],
  "provides" : [
    "com.dozersandbox/dirac@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/dirac-run/dirac"
}
