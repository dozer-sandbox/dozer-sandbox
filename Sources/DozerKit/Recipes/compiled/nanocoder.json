{
  "args" : {
    "version" : {
      "buildArg" : "NANOCODER_VERSION",
      "default" : "1.31.0",
      "description" : "The Nanocoder release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Nano Collective",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.anthropic.com",
                "reason" : "Anthropic — when the sandbox's key is Anthropic's"
              },
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/chat/completions"
                ],
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:nanocoder",
            "phrase" : "talk to your AI model",
            "summary" : "Nanocoder's model — the provider or gateway its key is for (Anthropic, OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for Nanocoder to answer.",
            "title" : "Talk to its model provider"
          },
          "quiet" : [
            {
              "host" : "models.dev",
              "reason" : "Nanocoder reads the public models.dev catalogue for a model's context size and prices (no setting turns it off); it does without it when refused"
            }
          ],
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.anthropic.com:443",
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443"
          ],
          "deny" : [
            "models.dev:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.config/nanocoder"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.local/share/nanocoder"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "binary" : "nanocoder",
        "integrity" : "sha512-EyJn8aO7YFKDA+IYyUmSN9/XHCqgBfrYKHE61iKMf6B4ASY9GDd8VHG0J09w0bd/V5kQdUQzHszk0fiCv8fRHQ==",
        "kind" : "npm",
        "needs_node" : "22",
        "npm_args" : [
          "--ignore-scripts"
        ],
        "package" : "@nanocollective/nanocoder"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "nanocoder",
            "run",
            "say ok",
            "--trust-directory",
            "--plain"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "nanocoder"
        ],
        "env" : {
          "NANOCODER_CONTEXT_LIMIT" : "256000"
        },
        "first_run" : [
          {
            "file" : "~/.config/nanocoder/agents.config.json",
            "set" : {
              "nanocoder.providers" : [
                {
                  "apiKey" : "${XAI_API_KEY}",
                  "baseUrl" : "https://api.x.ai/v1",
                  "models" : [
                    "grok-build-0.1"
                  ],
                  "name" : "Dozer",
                  "sdkProvider" : "openai-compatible"
                }
              ]
            }
          },
          {
            "file" : "~/.config/nanocoder/nanocoder-preferences.json",
            "set" : {
              "trustedDirectories" : [
                "/workspace"
              ]
            }
          }
        ],
        "no_prompts_args" : [
          "--mode",
          "yolo"
        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h",
          "run",
          "init",
          "review",
          "config",
          "skills",
          "completion"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "nanocoder",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Nanocoder's provider from the environment (NANOCODER_PROVIDERS: an OpenAI-compatible provider at the chosen source's base URL, or its Anthropic client; its apiKey the reference $OPENAI_API_KEY or $ANTHROPIC_API_KEY, which Nanocoder expands each run, so the key is never written there). On xAI (the default) the model is grok-build-0.1.",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "api-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.anthropic.com/settings/keys",
            "kind" : "api-key",
            "note" : "Nanocoder through Anthropic: doz try nanocoder --provider anthropic (or choose it in the try setup); the model with --model.",
            "provider" : "anthropic"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "Nanocoder through OpenAI: doz try nanocoder --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "Nanocoder through Google AI: doz try nanocoder --provider google (or choose it in the try setup); the model with --model.",
            "provider" : "google"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "Nanocoder through OpenRouter: doz try nanocoder --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://vercel.com/docs/ai-gateway/authentication-and-byok",
            "kind" : "api-key",
            "note" : "Nanocoder through Vercel AI Gateway: doz try nanocoder --gateway vercel-ai-gateway (or choose it in the try setup); the model with --model.",
            "provider" : "vercel-ai-gateway"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "level" : "verified"
          },
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in Vercel AI Gateway (doz try with --gateway vercel-ai-gateway; models@1)",
            "gateway" : "vercel-ai-gateway",
            "level" : "verified"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "models" : {
          "xai" : "grok-build-0.1"
        },
        "shapes" : [
          {
            "env" : {
              "NANOCODER_PROVIDERS" : "[{\"name\":\"Dozer\",\"sdkProvider\":\"openai-compatible\",\"baseUrl\":\"${{ dozer.base_url }}\",\"apiKey\":\"$OPENAI_API_KEY\",\"models\":[\"${{ dozer.model }}\"]}]"
            },
            "key_env" : [
              "OPENAI_API_KEY"
            ],
            "shape" : "openai-chat",
            "source" : "https://github.com/Nano-Collective/nanocoder/blob/v1.31.0/docs/configuration/providers/index.md"
          },
          {
            "env" : {
              "NANOCODER_PROVIDERS" : "[{\"name\":\"Dozer\",\"sdkProvider\":\"anthropic\",\"baseUrl\":\"${{ dozer.base_url }}/v1\",\"apiKey\":\"$ANTHROPIC_API_KEY\",\"models\":[\"${{ dozer.model }}\"]}]"
            },
            "key_env" : [
              "ANTHROPIC_API_KEY"
            ],
            "shape" : "anthropic-messages",
            "source" : "https://github.com/Nano-Collective/nanocoder/blob/v1.31.0/docs/configuration/providers/index.md"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "node",
        "icon" : "nanocoder",
        "kind" : "coding-agent",
        "limits" : [
          {
            "musl" : true,
            "reason" : "not checked on Alpine"
          }
        ],
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: nanocoder run \"say ok\" printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "nanocoder run \"…\" --trust-directory --plain"
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default)."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/Nano-Collective/nanocoder",
        "intro" : "Nanocoder is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "nanocoder run \"say ok\" --trust-directory --plain",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "nanocoder run \"list the files in this folder\" --trust-directory --plain",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "The Nano Collective's local-first coding agent for the terminal, on the key of the provider or gateway you choose (xAI by default).",
  "displayName" : "Nanocoder",
  "id" : "nano-collective/nanocoder",
  "kind" : "workload",
  "licenses" : [
    "MIT"
  ],
  "provides" : [
    "com.dozersandbox/nanocoder@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/Nano-Collective/nanocoder"
}
