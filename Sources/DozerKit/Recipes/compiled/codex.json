{
  "args" : {
    "version" : {
      "buildArg" : "CODEX_VERSION",
      "default" : "0.160.1",
      "description" : "The Codex release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "OpenAI",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "chatgpt.com"
              },
              {
                "host" : "api.openai.com"
              },
              {
                "host" : "ab.chatgpt.com"
              }
            ],
            "id" : "model:openai",
            "title" : "Talk to OpenAI"
          },
          "update" : [

          ],
          "vendor" : [
            {
              "exact_paths" : [
                "/openai/codex/main/announcement_tip.toml"
              ],
              "host" : "raw.githubusercontent.com",
              "reason" : "Codex reads OpenAI's start-up tips (announcement_tip.toml on GitHub) when it starts"
            },
            {
              "exact_paths" : [
                "/openai/plugins.git/info/refs",
                "/openai/plugins.git/git-upload-pack"
              ],
              "host" : "github.com",
              "reason" : "Codex fetches OpenAI's curated plugins (openai/plugins.git, read only) when it starts"
            },
            {
              "host" : "files.openai.com",
              "reason" : "OpenAI's own site — called at start-up (not identified)"
            }
          ]
        },
        "runtime" : {
          "allow" : [
            "chatgpt.com:443",
            "api.openai.com:443",
            "ab.chatgpt.com:443",
            "raw.githubusercontent.com:443",
            "github.com:443",
            "files.openai.com:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.openai.com",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "OPENAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "codex-mac",
            "chatgpt",
            "openai-key"
          ]
        },
        "phase" : "runtime",
        "service" : "openai"
      },
      "description" : "OpenAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.codex"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "directory" : "/home/agent/.agents/skills/dozer",
        "dozer" : {
          "kind" : "skill"
        },
        "filename" : "SKILL.md"
      },
      "type" : "com.docker.sandbox/agent-context@1"
    },
    {
      "config" : {
        "binary" : "codex",
        "builtin" : true,
        "integrity" : "sha512-JLyjBlmjPvwTaicHemw+y5xQSz3Uja2r7F/xkvS8gFufTA2g132Ak+0fo35xnJ/k2uc9fTtjm0LrsEGI78L6Ng==",
        "kind" : "builtin",
        "package" : "@openai/codex"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "codex",
            "exec",
            "--skip-git-repo-check",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "codex"
        ],
        "env" : {

        },
        "no_prompts_args" : [
          "--dangerously-bypass-approvals-and-sandbox"
        ],
        "passthrough" : [
          "login",
          "logout",
          "mcp",
          "--version",
          "-V",
          "--help",
          "-h"
        ],
        "resume" : [
          "resume",
          "--last"
        ],
        "settings" : {
          "permissions" : "codex.permissions",
          "version" : "images.codex_version"
        },
        "state_env" : {
          "CODEX_HOME" : "/home/agent/.codex"
        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "codex",
              "--version"
            ],
            "expect" : "codex-cli ${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "account" : "a ChatGPT plan",
            "accounts" : [
              "codex-mac",
              "chatgpt"
            ],
            "checked" : "2026-10-12",
            "kind" : "vendor-sign-in",
            "note" : "This Mac's own Codex login (the account mac, read-only), or Dozer's own ChatGPT sign-in on this Mac (doz account add NAME --chatgpt). The sign-in stays on the Mac — the sandbox's auth.json holds placeholders."
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-12",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "provider" : "openai"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-12",
            "endpoint" : "v1",
            "gateway" : "openrouter",
            "how" : {
              "config" : [
                {
                  "file" : "~/.codex/config.toml",
                  "set" : {
                    "model_provider" : "openrouter",
                    "model_providers.openrouter.base_url" : "${{ dozer.gateway.endpoint.v1 }}",
                    "model_providers.openrouter.env_key" : "OPENROUTER_API_KEY",
                    "model_providers.openrouter.name" : "openrouter",
                    "model_providers.openrouter.wire_api" : "responses"
                  }
                }
              ],
              "env" : {
                "OPENROUTER_API_KEY" : "${{ dozer.placeholder }}"
              },
              "model_args" : [
                "--model",
                "${{ dozer.model }}"
              ]
            },
            "level" : "documented",
            "limits" : [
              "not offered in a Dozer try: Codex takes a provider's base URL only from its config.toml (or -c), and its launcher is Dozer's own (baked into its image); its ChatGPT and OpenAI accounts stay its path",
              "with env_key Codex does not fetch OpenRouter's model catalogue: other makers' models show an \"Unknown model\" warning (OpenRouter recommends an auth command instead)"
            ],
            "notes" : [
              "wire_api = responses is added here: OpenRouter's page omits it, and Codex speaks only the Responses API (Vercel's page)"
            ],
            "shape" : "openai-responses",
            "source" : "https://openrouter.ai/docs/cookbook/coding-agents/codex-cli.md"
          },
          {
            "checked" : "2026-10-12",
            "endpoint" : "codex",
            "gateway" : "vercel-ai-gateway",
            "how" : {
              "config" : [
                {
                  "file" : "~/.codex/config.toml",
                  "set" : {
                    "model_provider" : "vercel",
                    "model_providers.vercel.base_url" : "${{ dozer.gateway.endpoint.codex }}",
                    "model_providers.vercel.env_key" : "AI_GATEWAY_API_KEY",
                    "model_providers.vercel.name" : "Vercel AI Gateway",
                    "model_providers.vercel.wire_api" : "responses"
                  }
                }
              ],
              "env" : {
                "AI_GATEWAY_API_KEY" : "${{ dozer.placeholder }}"
              },
              "model_args" : [
                "--model",
                "${{ dozer.model }}"
              ]
            },
            "level" : "documented",
            "limits" : [
              "not offered in a Dozer try: Codex takes a provider's base URL only from its config.toml (or -c), and its launcher is Dozer's own (baked into its image); its ChatGPT and OpenAI accounts stay its path"
            ],
            "notes" : [
              "/codex/v1 is Codex's own compatibility endpoint; /model lists the gateway's catalogue"
            ],
            "shape" : "openai-responses",
            "source" : "https://vercel.com/docs/ai-gateway/coding-agents"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "node",
        "icon" : "codex",
        "kind" : "coding-agent",
        "platforms" : {
          "glibc" : true,
          "musl" : true
        },
        "tags" : [
          {
            "checked" : "2026-10-12",
            "level" : "documented",
            "notes" : [
              "codex exec"
            ],
            "source" : "https://learn.chatgpt.com/codex/non-interactive-mode",
            "tag" : "headless"
          }
        ]
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/openai/codex",
        "intro" : "Codex is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "codex exec --skip-git-repo-check \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "codex exec --skip-git-repo-check \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "OpenAI's open-source coding agent.",
  "displayName" : "Codex",
  "id" : "openai/codex",
  "kind" : "workload",
  "licenses" : [
    "Apache-2.0"
  ],
  "provides" : [
    "com.dozersandbox/codex@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/openai/codex"
}
