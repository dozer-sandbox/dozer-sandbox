{
  "args" : {
    "version" : {
      "buildArg" : "QWEN_CODE_VERSION",
      "default" : "0.25.1",
      "description" : "The Qwen Code release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Alibaba Qwen",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/models",
                  "/v1/chat/completions",
                  "/v1/responses"
                ]
              }
            ],
            "id" : "model:qwen-code",
            "phrase" : "talk to your AI model (xAI)",
            "summary" : "Qwen Code's model here (the xAI API, OpenAI-compatible, with your key) — needed for it to answer.",
            "title" : "Talk to xAI"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.x.ai:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ],
          "env_aliases" : [
            "OPENAI_API_KEY"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.qwen"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "directory" : "/home/agent/.qwen/skills/dozer",
        "dozer" : {
          "kind" : "skill"
        },
        "filename" : "SKILL.md"
      },
      "type" : "com.docker.sandbox/agent-context@1"
    },
    {
      "config" : {
        "binary" : "qwen",
        "integrity" : "sha512-6cEbtfx4Ugl1d3FdFLa8fcsG6knHuUUHqvDseLxGY06Xan8p7Fcd7+g5KlX694zX4mo/+Vh56AHxT/4R15zpYA==",
        "kind" : "npm",
        "needs_node" : "22",
        "npm_args" : [
          "--ignore-scripts"
        ],
        "package" : "@qwen-code/qwen-code"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "qwen",
            "-p",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "qwen"
        ],
        "env" : {
          "OPENAI_BASE_URL" : "https://api.x.ai/v1",
          "OPENAI_MODEL" : "grok-code-fast-1",
          "QWEN_CODE_MODELS_DEV" : "off"
        },
        "first_run" : [
          {
            "file" : "~/.qwen/settings.json",
            "set" : {
              "general.enableAutoUpdate" : false,
              "privacy.usageStatisticsEnabled" : false,
              "security.auth.selectedType" : "openai"
            }
          }
        ],
        "no_prompts_args" : [
          "--approval-mode=yolo"
        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h",
          "mcp",
          "extensions"
        ],
        "resume" : [
          "--continue"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "qwen",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Qwen Code's OpenAI-compatible mode (OPENAI_BASE_URL at xAI's API, OPENAI_MODEL grok-code-fast-1). Its free Qwen sign-in ended on 2026-04-15; Dozer does not offer Qwen's own keys yet.",
            "provider" : "xai"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "endpoint" : "v1",
            "gateway" : "openrouter",
            "how" : {
              "env" : {
                "OPENAI_API_KEY" : "${{ dozer.placeholder }}",
                "OPENAI_BASE_URL" : "${{ dozer.gateway.endpoint.v1 }}",
                "OPENAI_MODEL" : "${{ dozer.model }}"
              }
            },
            "level" : "documented",
            "shape" : "openai-chat",
            "source" : "https://qwenlm.github.io/qwen-code-docs/en/users/configuration/auth/"
          },
          {
            "checked" : "2026-10-14",
            "endpoint" : "v1",
            "gateway" : "vercel-ai-gateway",
            "how" : {
              "env" : {
                "OPENAI_API_KEY" : "${{ dozer.placeholder }}",
                "OPENAI_BASE_URL" : "${{ dozer.gateway.endpoint.v1 }}",
                "OPENAI_MODEL" : "${{ dozer.model }}"
              }
            },
            "level" : "documented",
            "shape" : "openai-chat",
            "source" : "https://qwenlm.github.io/qwen-code-docs/en/users/configuration/auth/"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "qwen"
        ],
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "node",
        "icon" : "qwen-code",
        "kind" : "coding-agent",
        "limits" : [
          {
            "musl" : true,
            "reason" : "Qwen Code needs Node 22 or later; Alpine's Node is older"
          }
        ],
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "level" : "documented",
            "notes" : [
              "qwen -p \"…\""
            ],
            "source" : "https://qwenlm.github.io/qwen-code-docs/",
            "tag" : "headless"
          }
        ],
        "terms" : "Your xAI API key — a key from console.x.ai."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/QwenLM/qwen-code",
        "intro" : "Qwen Code is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "qwen -p \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "qwen -p \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "Alibaba Qwen's open-source coding agent (a Gemini CLI fork), here on an xAI API key through its OpenAI-compatible mode.",
  "displayName" : "Qwen Code",
  "id" : "qwenlm/qwen-code",
  "kind" : "workload",
  "licenses" : [
    "Apache-2.0"
  ],
  "provides" : [
    "com.dozersandbox/qwen-code@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/QwenLM/qwen-code"
}
