{
  "args" : {
    "version" : {
      "buildArg" : "OMP_VERSION",
      "default" : "18.10.4",
      "description" : "The oh-my-pi release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "can1357 and contributors",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/models",
                  "/v1/responses",
                  "/v1/chat/completions"
                ]
              }
            ],
            "id" : "model:omp",
            "phrase" : "talk to your AI model (xAI)",
            "summary" : "oh-my-pi's model here (the xAI API, with your key) — needed for it to answer.",
            "title" : "Talk to xAI"
          },
          "quiet" : [
            {
              "host" : "api.commandcode.ai",
              "reason" : "oh-my-pi asks several model gateways for their public model lists when it starts (no setting turns it off); it does without them when refused"
            },
            {
              "host" : "api.kilo.ai",
              "reason" : "the same start-up model-list discovery (Kilo Gateway)"
            },
            {
              "host" : "api.venice.ai",
              "reason" : "the same start-up model-list discovery (Venice)"
            },
            {
              "host" : "build.stencil.so",
              "reason" : "oh-my-pi's release check when it starts (Dozer installs the pinned release); it carries on without it"
            },
            {
              "host" : "catalog.stencil.so",
              "reason" : "the same start-up model-list discovery (a public model catalogue)"
            },
            {
              "host" : "coding-intl.dashscope.aliyuncs.com",
              "reason" : "the same start-up model-list discovery (Alibaba Model Studio)"
            },
            {
              "host" : "hyper.charm.land",
              "reason" : "the same start-up model-list discovery (Charm Hyper)"
            },
            {
              "host" : "zenmux.ai",
              "reason" : "the same start-up model-list discovery (ZenMux)"
            }
          ],
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.x.ai:443"
          ],
          "deny" : [
            "api.commandcode.ai:443",
            "api.kilo.ai:443",
            "api.venice.ai:443",
            "build.stencil.so:443",
            "catalog.stencil.so:443",
            "coding-intl.dashscope.aliyuncs.com:443",
            "hyper.charm.land:443",
            "zenmux.ai:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.omp"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "github.com",
          "release-assets.githubusercontent.com"
        ],
        "binary" : "omp",
        "integrity" : "sha512-3ZmxKel2M9fL+bMtRZe9SLZSzJpW3CPn04l8ShQXjNx3r34o8iZKhReT1PEoPWr5N/s/fH+UIdhemFj0Ytv/yg==",
        "kind" : "release-binary",
        "url" : "https://github.com/can1357/oh-my-pi/releases/download/v${{ kit.args.version }}/omp-linux-arm64"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "omp",
            "-p",
            "--model",
            "xai/grok-build-0.1",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK"
        },
        "command" : [
          "omp",
          "--model",
          "xai/grok-build-0.1"
        ],
        "env" : {

        },
        "first_run" : [
          {
            "file" : "~/.omp/agent/config.yml",
            "set" : {
              "setupVersion" : 2
            }
          }
        ],
        "no_prompts_args" : [

        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h",
          "-p",
          "--print",
          "toks"
        ],
        "resume" : [
          "--continue"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "omp",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-14",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "oh-my-pi's built-in xAI provider reads XAI_API_KEY; model xai/grok-build-0.1 in the command.",
            "provider" : "xai"
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-14",
            "gateway" : "openrouter",
            "level" : "unknown",
            "reason" : "oh-my-pi reads OPENROUTER_API_KEY; not checked"
          },
          {
            "checked" : "2026-10-14",
            "gateway" : "vercel-ai-gateway",
            "level" : "unknown",
            "reason" : "oh-my-pi reads AI_GATEWAY_API_KEY; not checked"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "oh-my-pi"
        ],
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "debian",
        "icon" : "omp",
        "kind" : "coding-agent",
        "limits" : [
          {
            "musl" : true,
            "reason" : "Dozer installs oh-my-pi's glibc build; its musl build is a separate download, not used yet"
          }
        ],
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: omp -p \"say ok\" printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "omp -p --model xai/grok-build-0.1 \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your xAI API key — a key from console.x.ai."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://github.com/can1357/oh-my-pi",
        "intro" : "oh-my-pi is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "omp -p --model xai/grok-build-0.1 \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "omp -p --model xai/grok-build-0.1 \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "A batteries-included derivative of the pi coding agent (omp), here on an xAI API key.",
  "displayName" : "oh-my-pi",
  "id" : "can1357/omp",
  "kind" : "workload",
  "licenses" : [
    "MIT"
  ],
  "provides" : [
    "com.dozersandbox/omp@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://github.com/can1357/oh-my-pi"
}
