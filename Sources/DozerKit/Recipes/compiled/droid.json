{
  "args" : {
    "version" : {
      "buildArg" : "DROID_VERSION",
      "default" : "0.240.1",
      "description" : "The Factory Droid release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Factory",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.anthropic.com",
                "reason" : "Anthropic — when the sandbox's key is Anthropic's"
              },
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/chat/completions"
                ],
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:droid",
            "phrase" : "talk to your AI model",
            "summary" : "Factory Droid's model — the provider or gateway its key is for (Anthropic, OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for Factory Droid to answer.",
            "title" : "Talk to its model provider"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.anthropic.com:443",
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.factory"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "directory" : "/home/agent/.factory/skills/dozer",
        "dozer" : {
          "kind" : "skill"
        },
        "filename" : "SKILL.md"
      },
      "type" : "com.docker.sandbox/agent-context@1"
    },
    {
      "config" : {
        "bake_hosts" : [
          "downloads.factory.ai"
        ],
        "binary" : "droid",
        "integrity" : "sha512-GmruvHDRWTbSNZ76lfS5iGWSTlekbTicf2EGNkzj/griE3bmR9uIaXqmFqp4fjBibjWlkX9q66BnjXl2B9/5vg==",
        "kind" : "release-binary",
        "url" : "https://downloads.factory.ai/factory-cli/releases/${{ kit.args.version }}/linux/arm64/droid"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "droid",
            "exec",
            "-m",
            "custom:${{ dozer.model }}",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK",
          "screen" : {
            "allow" : [
              "Try \".*login"
            ]
          }
        },
        "command" : [
          "droid"
        ],
        "env" : {
          "FACTORY_AIRGAP_ENABLED" : "1"
        },
        "first_run" : [
          {
            "file" : "~/.factory/settings.json",
            "set" : {
              "customModels" : [
                {
                  "apiKeyHelper" : "printenv XAI_API_KEY",
                  "baseUrl" : "https://api.x.ai/v1",
                  "displayName" : "Grok Build",
                  "maxOutputTokens" : 8192,
                  "model" : "grok-build-0.1",
                  "provider" : "generic-chat-completion-api"
                }
              ],
              "trustedFolders" : {
                "/workspace" : {
                  "trustedAt" : "2026-10-14T00:00:00.000Z"
                }
              }
            }
          },
          {
            "each_run" : true,
            "file" : "~/.factory/settings.json",
            "set" : {
              "customModels" : [
                {
                  "apiKeyHelper" : "printenv $DOZ_KEY_VAR",
                  "baseUrl" : "$DOZ_BASE_URL",
                  "displayName" : "$DOZ_MODEL",
                  "maxOutputTokens" : 8192,
                  "model" : "$DOZ_MODEL",
                  "provider" : "$DOZ_DROID_PROVIDER"
                }
              ]
            }
          }
        ],
        "no_prompts_args" : [
          "--auto",
          "high"
        ],
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h",
          "help",
          "exec",
          "search",
          "find",
          "update",
          "mcp",
          "plugin",
          "doctor"
        ],
        "resume" : [
          "--resume",
          "--last"
        ],
        "state_env" : {

        },
        "status" : "osc7501",
        "verify" : [
          {
            "argv" : [
              "droid",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "Droid's custom model (its settings' customModels, written at every run: the chosen source's base URL and model, generic Chat Completions or Anthropic; the key printed from the variable its placeholder is in). On xAI (the default) the model is grok-build-0.1. Factory's account, models and cloud are not used (airgap mode).",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "api-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.anthropic.com/settings/keys",
            "kind" : "api-key",
            "note" : "Factory Droid through Anthropic: doz try droid --provider anthropic (or choose it in the try setup); the model with --model.",
            "provider" : "anthropic"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "Factory Droid through OpenAI: doz try droid --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "Factory Droid through Google AI: doz try droid --provider google (or choose it in the try setup); the model with --model.",
            "provider" : "google"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "Factory Droid through OpenRouter: doz try droid --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://vercel.com/docs/ai-gateway/authentication-and-byok",
            "kind" : "api-key",
            "note" : "Factory Droid through Vercel AI Gateway: doz try droid --gateway vercel-ai-gateway (or choose it in the try setup); the model with --model.",
            "provider" : "vercel-ai-gateway"
          },
          {
            "account" : "a Factory account (FACTORY_API_KEY or its sign-in)",
            "checked" : "2026-10-14",
            "in_sandbox" : false,
            "kind" : "vendor-sign-in",
            "note" : "Factory's own models and account need its servers, which airgap mode keeps out; Dozer does not offer them yet."
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "level" : "verified"
          },
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in Vercel AI Gateway (doz try with --gateway vercel-ai-gateway; models@1)",
            "gateway" : "vercel-ai-gateway",
            "level" : "verified"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "models" : {
          "xai" : "grok-build-0.1"
        },
        "shapes" : [
          {
            "env" : {
              "DOZ_BASE_URL" : "${{ dozer.base_url }}",
              "DOZ_DROID_PROVIDER" : "generic-chat-completion-api",
              "DOZ_KEY_VAR" : "OPENAI_API_KEY",
              "DOZ_MODEL" : "${{ dozer.model }}"
            },
            "key_env" : [
              "OPENAI_API_KEY"
            ],
            "shape" : "openai-chat",
            "source" : "https://docs.factory.ai/cli/byok/overview"
          },
          {
            "env" : {
              "DOZ_BASE_URL" : "${{ dozer.base_url }}",
              "DOZ_DROID_PROVIDER" : "anthropic",
              "DOZ_KEY_VAR" : "ANTHROPIC_API_KEY",
              "DOZ_MODEL" : "${{ dozer.model }}"
            },
            "key_env" : [
              "ANTHROPIC_API_KEY"
            ],
            "shape" : "anthropic-messages",
            "source" : "https://docs.factory.ai/cli/byok/overview"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "factory",
          "factory-droid"
        ],
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "debian",
        "icon" : "droid",
        "kind" : "coding-agent",
        "limits" : [
          {
            "musl" : true,
            "reason" : "Factory publishes a glibc linux-arm64 build only"
          }
        ],
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: droid exec printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "droid exec -m custom:MODEL \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default). Droid runs in its airgap mode; Factory's account, models and cloud features are not used."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://docs.factory.com/droid-cli/overview",
        "intro" : "Factory Droid is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "droid exec -m \"custom:$DOZ_MODEL\" \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "droid exec -m \"custom:$DOZ_MODEL\" \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "Factory's coding agent for the terminal, in its airgap mode with your own key of the provider or gateway you choose (xAI by default; no Factory account).",
  "displayName" : "Factory Droid",
  "id" : "factory-ai/droid",
  "kind" : "workload",
  "licenses" : [
    "LicenseRef-Factory-Droid"
  ],
  "provides" : [
    "com.dozersandbox/droid@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://docs.factory.com/droid-cli/overview"
}
