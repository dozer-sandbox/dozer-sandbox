{
  "args" : {
    "version" : {
      "buildArg" : "MIMO_CODE_VERSION",
      "default" : "0.1.15",
      "description" : "The MiMo Code release Dozer installs (its pin).",
      "pattern" : "[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?"
    }
  },
  "author" : "Xiaomi",
  "capabilities" : [
    {
      "config" : {
        "dozer" : {
          "excluded" : [

          ],
          "model" : {
            "hosts" : [
              {
                "host" : "api.anthropic.com",
                "reason" : "Anthropic — when the sandbox's key is Anthropic's"
              },
              {
                "host" : "api.openai.com",
                "reason" : "OpenAI — when the sandbox's key is OpenAI's"
              },
              {
                "host" : "api.x.ai",
                "paths" : [
                  "/v1/responses",
                  "/v1/chat/completions"
                ],
                "reason" : "xAI — when the sandbox's key is xAI's"
              },
              {
                "host" : "generativelanguage.googleapis.com",
                "reason" : "Google AI — when the sandbox's key is Google AI's"
              },
              {
                "host" : "openrouter.ai",
                "reason" : "OpenRouter — when the sandbox's key is OpenRouter's"
              },
              {
                "host" : "ai-gateway.vercel.sh",
                "reason" : "Vercel AI Gateway — when the sandbox's key is Vercel AI Gateway's"
              }
            ],
            "id" : "model:mimo-code",
            "phrase" : "talk to your AI model",
            "summary" : "MiMo Code's model — the provider or gateway its key is for (Anthropic, OpenAI, xAI, Google AI, OpenRouter or Vercel AI Gateway), with an API key. Needed for MiMo Code to answer.",
            "title" : "Talk to its model provider"
          },
          "update" : [

          ]
        },
        "runtime" : {
          "allow" : [
            "api.anthropic.com:443",
            "api.openai.com:443",
            "api.x.ai:443",
            "generativelanguage.googleapis.com:443",
            "openrouter.ai:443",
            "ai-gateway.vercel.sh:443"
          ]
        }
      },
      "type" : "com.docker.sandbox/network-policy@1"
    },
    {
      "config" : {
        "apiKey" : {
          "inject" : [
            {
              "domain" : "api.x.ai",
              "format" : "Bearer %s",
              "header" : "authorization"
            }
          ],
          "name" : "XAI_API_KEY",
          "proxyManaged" : true
        },
        "dozer" : {
          "accounts" : [
            "key"
          ]
        },
        "phase" : "runtime",
        "service" : "xai"
      },
      "description" : "xAI API access",
      "type" : "com.docker.sandbox/credential@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.local/share/mimocode"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "path" : "/home/agent/.config/mimocode"
      },
      "type" : "com.docker.sandbox/volume@1"
    },
    {
      "config" : {
        "binary" : "mimo",
        "integrity" : "sha512-x5x7cRstiRlSuXIPUcXs8UTH5JxbJwrd2XwKlX4Z8bxuXf8kxu7udm0qMuti7QRQ3U2vY/G4uTSZ5B1Vz3S4yw==",
        "kind" : "npm-platform-binary",
        "package" : "@mimo-ai/cli",
        "payload" : "bin/mimo",
        "platform_package" : "@mimo-ai/mimocode-linux-arm64"
      },
      "type" : "com.dozersandbox/install@1"
    },
    {
      "config" : {
        "check" : {
          "argv" : [
            "mimo",
            "run",
            "say ok"
          ],
          "expect" : "DOZ_FAKE_OK",
          "screen" : {
            "allow" : [
              "Tip .*(/login|sign in)"
            ],
            "expect" : [
              "Type your message"
            ]
          }
        },
        "command" : [
          "mimo"
        ],
        "env" : {
          "MIMOCODE_DISABLE_AUTOUPDATE" : "1",
          "MIMOCODE_DISABLE_LSP_DOWNLOAD" : "1",
          "MIMOCODE_DISABLE_MODELS_FETCH" : "1",
          "MIMOCODE_DISABLE_SHARE" : "1",
          "MIMOCODE_ENABLE_ANALYSIS" : "false"
        },
        "first_run" : [
          {
            "file" : "~/.config/mimocode/mimocode.json",
            "set" : {
              "autoupdate" : false,
              "model" : "xai/grok-build-0.1",
              "share" : "disabled"
            }
          },
          {
            "file" : "~/.local/share/mimocode/trusted-workspaces.json",
            "set" : {
              "trustedPaths" : [
                "/workspace"
              ],
              "version" : 1
            }
          }
        ],
        "no_prompts_args" : [

        ],
        "no_prompts_env" : {
          "MIMOCODE_DANGEROUSLY_SKIP_PERMISSIONS" : "1"
        },
        "passthrough" : [
          "--version",
          "-v",
          "--help",
          "-h",
          "run",
          "auth",
          "models",
          "upgrade",
          "mcp",
          "stats"
        ],
        "resume" : [
          "--continue"
        ],
        "state_env" : {

        },
        "status" : "none",
        "verify" : [
          {
            "argv" : [
              "mimo",
              "--version"
            ],
            "expect" : "${{ kit.args.version }}"
          }
        ]
      },
      "type" : "com.dozersandbox/launch@1"
    },
    {
      "config" : {
        "methods" : [
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.x.ai/",
            "kind" : "api-key",
            "note" : "MiMo Code's own providers (OpenCode's), each reading its key from the environment; the chosen model through MIMOCODE_CONFIG_CONTENT (xai/grok-build-0.1 on xAI, the default). Its MiMo Platform and ChatGPT sign-ins are not offered.",
            "provider" : "xai"
          },
          {
            "accounts" : [
              "api-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://console.anthropic.com/settings/keys",
            "kind" : "api-key",
            "note" : "MiMo Code through Anthropic: doz try mimo-code --provider anthropic (or choose it in the try setup); the model with --model.",
            "provider" : "anthropic"
          },
          {
            "accounts" : [
              "openai-key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://platform.openai.com/api-keys",
            "kind" : "api-key",
            "note" : "MiMo Code through OpenAI: doz try mimo-code --provider openai (or choose it in the try setup); the model with --model.",
            "provider" : "openai"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://aistudio.google.com/apikey",
            "kind" : "api-key",
            "note" : "MiMo Code through Google AI: doz try mimo-code --provider google (or choose it in the try setup); the model with --model.",
            "provider" : "google"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://openrouter.ai/keys",
            "kind" : "api-key",
            "note" : "MiMo Code through OpenRouter: doz try mimo-code --gateway openrouter (or choose it in the try setup); the model with --model.",
            "provider" : "openrouter"
          },
          {
            "accounts" : [
              "key"
            ],
            "checked" : "2026-10-16",
            "keys_page" : "https://vercel.com/docs/ai-gateway/authentication-and-byok",
            "kind" : "api-key",
            "note" : "MiMo Code through Vercel AI Gateway: doz try mimo-code --gateway vercel-ai-gateway (or choose it in the try setup); the model with --model.",
            "provider" : "vercel-ai-gateway"
          },
          {
            "account" : "a MiMo Platform account (Xiaomi)",
            "checked" : "2026-10-14",
            "in_sandbox" : false,
            "kind" : "vendor-sign-in",
            "note" : "MiMo's own models need its sign-in; Dozer does not offer it yet."
          }
        ]
      },
      "type" : "com.dozersandbox/auth@1"
    },
    {
      "config" : {
        "entries" : [
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in OpenRouter (doz try with --gateway openrouter; models@1)",
            "gateway" : "openrouter",
            "level" : "verified"
          },
          {
            "checked" : "2026-10-16",
            "evidence" : "make recipe-check: its check turn through a stand-in Vercel AI Gateway (doz try with --gateway vercel-ai-gateway; models@1)",
            "gateway" : "vercel-ai-gateway",
            "level" : "verified"
          }
        ]
      },
      "type" : "com.dozersandbox/gateways@1"
    },
    {
      "config" : {
        "default" : "xai",
        "models" : {
          "xai" : "grok-build-0.1"
        },
        "native" : [
          {
            "env" : {
              "MIMOCODE_CONFIG_CONTENT" : "{\"model\":\"anthropic/${{ dozer.model }}\"}"
            },
            "source" : "anthropic"
          },
          {
            "env" : {
              "MIMOCODE_CONFIG_CONTENT" : "{\"model\":\"openai/${{ dozer.model }}\"}"
            },
            "source" : "openai"
          },
          {
            "env" : {
              "MIMOCODE_CONFIG_CONTENT" : "{\"model\":\"xai/${{ dozer.model }}\"}"
            },
            "source" : "xai"
          },
          {
            "env" : {
              "MIMOCODE_CONFIG_CONTENT" : "{\"model\":\"google/${{ dozer.model }}\"}"
            },
            "key_env" : [
              "GOOGLE_GENERATIVE_AI_API_KEY"
            ],
            "source" : "google"
          },
          {
            "docs" : "https://mimo.xiaomi.com/coder",
            "env" : {
              "MIMOCODE_CONFIG_CONTENT" : "{\"model\":\"openrouter/${{ dozer.model }}\"}"
            },
            "source" : "openrouter"
          },
          {
            "docs" : "https://mimo.xiaomi.com/coder",
            "env" : {
              "MIMOCODE_CONFIG_CONTENT" : "{\"model\":\"gateway/${{ dozer.model }}\",\"provider\":{\"gateway\":{\"npm\":\"@ai-sdk/openai-compatible\",\"name\":\"Vercel AI Gateway\",\"options\":{\"baseURL\":\"https://ai-gateway.vercel.sh/v1\",\"apiKey\":\"{env:AI_GATEWAY_API_KEY}\"},\"models\":{\"${{ dozer.model }}\":{}}}}}"
            },
            "source" : "vercel-ai-gateway"
          }
        ]
      },
      "type" : "com.dozersandbox/models@1"
    },
    {
      "config" : {
        "checked" : "2026-10-14"
      },
      "type" : "com.dozersandbox/currency@1"
    },
    {
      "config" : {
        "aliases" : [
          "mimo",
          "mimocode"
        ],
        "categories" : [
          "coding-agent"
        ],
        "default_base" : "debian",
        "icon" : "mimo-code",
        "kind" : "coding-agent",
        "limits" : [
          {
            "musl" : true,
            "reason" : "Dozer installs MiMo Code's glibc build; its musl build is a separate package, not used yet"
          }
        ],
        "platforms" : {
          "glibc" : true,
          "musl" : false
        },
        "tags" : [
          {
            "checked" : "2026-10-14",
            "evidence" : "make recipe-check: mimo run \"say ok\" printed the stand-in's answer and exited in a fresh try",
            "level" : "verified",
            "notes" : [
              "mimo run \"…\""
            ],
            "tag" : "headless"
          }
        ],
        "terms" : "Your API key of the provider or gateway you choose (xAI by default). MiMo Code comes with Xiaomi's use restrictions beside its MIT licence; its usage analytics are off."
      },
      "type" : "com.dozersandbox/directory@1"
    },
    {
      "config" : {
        "docs" : "https://mimo.xiaomi.com",
        "intro" : "MiMo Code is a coding agent with its own screen: the session on the left. Ask it to read, change and run the code in your folder.",
        "steps" : [
          {
            "command" : "mimo run \"say ok\"",
            "text" : "Check it answers, without its screen."
          },
          {
            "text" : "Ask it something in its own screen — the session on the left."
          },
          {
            "command" : "mimo run \"list the files in this folder\"",
            "text" : "One task without its screen."
          }
        ],
        "tips" : [
          "Files it makes are in /workspace — your folder on the Mac.",
          "Restart its session from the session's ⋯ menu; End stops it."
        ]
      },
      "type" : "com.dozersandbox/guide@1"
    }
  ],
  "description" : "Xiaomi's coding agent for the terminal (an OpenCode derivative), on the key of the provider or gateway you choose (xAI by default).",
  "displayName" : "MiMo Code",
  "id" : "xiaomi/mimo-code",
  "kind" : "workload",
  "licenses" : [
    "MIT"
  ],
  "provides" : [
    "com.dozersandbox/mimo-code@${{ kit.args.version }}"
  ],
  "schema" : 2,
  "sourceUrl" : "https://mimo.xiaomi.com"
}
